<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Champions of Europe | Dream Team Builder</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-dark: #001845;
            --bg-card: #003366;
            --bg-hover: #004d99;
            --accent: #00d4ff;
            --accent-dim: #0099cc;
            --gold: #ffd700;
            --silver: #c0c0c0;
            --bronze: #cd7f32;
            --text-primary: #ffffff;
            --text-secondary: #99ccff;
            --danger: #ff4757;
            --warning: #ffa502;
        }

        body {
            font-family: 'Oswald', 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #001845 0%, #003366 50%, #001845 100%);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* Animated background with particles */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 20% 50%, rgba(0, 212, 255, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(0, 153, 204, 0.1) 0%, transparent 50%);
            pointer-events: none;
            z-index: -1;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Header */
        .header {
            text-align: center;
            padding: 40px 20px;
            position: relative;
        }

        .logo {
            font-size: 4rem;
            font-weight: 900;
            letter-spacing: 4px;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
            text-transform: uppercase;
            color: var(--text-primary);
            text-shadow: 0 4px 20px rgba(0, 212, 255, 0.5), 0 0 40px rgba(0, 212, 255, 0.3);
            animation: glow-pulse 3s ease-in-out infinite;
        }

        @keyframes glow-pulse {
            0%, 100% { text-shadow: 0 4px 20px rgba(0, 212, 255, 0.5), 0 0 40px rgba(0, 212, 255, 0.3); }
            50% { text-shadow: 0 4px 30px rgba(0, 212, 255, 0.8), 0 0 60px rgba(0, 212, 255, 0.5); }
        }

        .subtitle {
            color: var(--text-secondary);
            font-size: 1.1rem;
            margin-top: 10px;
            letter-spacing: 3px;
            text-transform: uppercase;
            font-weight: 700;
        }

        /* Screens */
        .screen {
            display: none;
            animation: fadeIn 0.4s ease;
        }

        .screen.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Start Screen */
        .start-options {
            display: flex;
            flex-direction: column;
            gap: 30px;
            max-width: 600px;
            margin: 0 auto;
        }

        .option-group {
            background: linear-gradient(135deg, rgba(0, 51, 102, 0.6) 0%, rgba(0, 102, 153, 0.4) 100%);
            border-radius: 16px;
            padding: 25px;
            border: 2px solid rgba(0, 212, 255, 0.3);
            backdrop-filter: blur(10px);
        }

        .option-group h3 {
            color: var(--accent);
            margin-bottom: 15px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 700;
        }

        .difficulty-buttons, .rating-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .diff-btn, .rating-btn {
            flex: 1;
            min-width: 120px;
            padding: 20px 15px;
            border: 2px solid rgba(0, 212, 255, 0.3);
            background: linear-gradient(135deg, rgba(0, 51, 102, 0.5) 0%, rgba(0, 102, 153, 0.3) 100%);
            color: var(--text-primary);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
            font-weight: 700;
        }

        .diff-btn:hover, .rating-btn:hover {
            border-color: var(--accent);
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.2) 0%, rgba(0, 153, 204, 0.15) 100%);
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.4);
        }

        .diff-btn.selected, .rating-btn.selected {
            border-color: var(--accent);
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.3) 0%, rgba(0, 153, 204, 0.2) 100%);
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
        }

        .diff-btn .name, .rating-btn .name {
            font-weight: 900;
            font-size: 1.1rem;
            margin-bottom: 8px;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
            letter-spacing: 1px;
        }

        .diff-btn .desc {
            font-size: 0.75rem;
            color: var(--text-secondary);
            line-height: 1.4;
        }

        .easy .name { color: #00ff88; }
        .medium .name { color: #ffa502; }
        .hard .name { color: #ff4757; }

        /* Tournament Selection */
        .tournament-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .tournament-card {
            background: linear-gradient(135deg, rgba(0, 51, 102, 0.6) 0%, rgba(0, 102, 153, 0.4) 100%);
            border: 2px solid rgba(0, 212, 255, 0.3);
            border-radius: 16px;
            padding: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            gap: 10px;
            backdrop-filter: blur(10px);
        }

        .tournament-card:hover {
            border-color: var(--accent);
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0, 212, 255, 0.2);
        }

        .tournament-card.selected {
            border-color: var(--accent);
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.2) 0%, rgba(0, 153, 204, 0.15) 100%);
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
        }

        .tournament-badge {
            font-size: 2.5rem;
        }

        .tournament-info h4 {
            font-size: 1.1rem;
            margin-bottom: 5px;
            font-weight: 700;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
            letter-spacing: 1px;
        }

        .tournament-info span {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        /* Main Button */
        .main-btn {
            display: block;
            width: 100%;
            max-width: 400px;
            margin: 30px auto;
            padding: 20px 40px;
            font-size: 1.2rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 3px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--accent) 0%, #00ccff 100%);
            color: #001845;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
            box-shadow: 0 4px 15px rgba(0, 212, 255, 0.3);
        }

        .main-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 30px rgba(0, 212, 255, 0.5);
        }

        .main-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        /* Team Builder */
        .builder-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .position-info {
            text-align: center;
        }

        .position-info h2 {
            font-size: 1.5rem;
            color: var(--accent);
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .position-info span {
            color: var(--text-secondary);
        }

        .team-rating {
            background: linear-gradient(135deg, rgba(0, 51, 102, 0.6) 0%, rgba(0, 102, 153, 0.4) 100%);
            padding: 15px 25px;
            border-radius: 12px;
            text-align: center;
            border: 2px solid rgba(0, 212, 255, 0.3);
        }

        .team-rating .label {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            font-weight: 700;
        }

        .team-rating .value {
            font-size: 2rem;
            font-weight: 900;
            color: var(--accent);
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
        }

        .rerolls-display {
            background: linear-gradient(135deg, rgba(0, 51, 102, 0.6) 0%, rgba(0, 102, 153, 0.4) 100%);
            padding: 15px 25px;
            border-radius: 12px;
            text-align: center;
            border: 2px solid rgba(0, 212, 255, 0.3);
        }

        .rerolls-display .label {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            font-weight: 700;
        }

        .rerolls-display .value {
            font-size: 1.5rem;
            font-weight: 900;
            color: var(--warning);
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
        }

        /* Formation Display */
        .formation-selector {
            margin-bottom: 30px;
        }

        .formation-selector h3 {
            margin-bottom: 15px;
            color: var(--text-secondary);
            font-size: 0.9rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 2px;
        }

        .formation-options {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .formation-btn {
            padding: 10px 20px;
            border: 2px solid rgba(0, 212, 255, 0.3);
            background: linear-gradient(135deg, rgba(0, 51, 102, 0.5) 0%, rgba(0, 102, 153, 0.3) 100%);
            color: var(--text-primary);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 700;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
        }

        .formation-btn:hover {
            border-color: var(--accent);
            box-shadow: 0 0 15px rgba(0, 212, 255, 0.3);
        }

        .formation-btn.selected {
            border-color: var(--accent);
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.2) 0%, rgba(0, 153, 204, 0.15) 100%);
            color: var(--accent);
        }

        /* Pitch Display */
        .pitch-container {
            background: linear-gradient(to bottom, #1a4d1a 0%, #2d5a2d 50%, #1a4d1a 100%);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 30px;
            position: relative;
            aspect-ratio: 3/4;
            max-height: 500px;
            overflow: hidden;
        }

        .pitch-lines {
            position: absolute;
            inset: 20px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 8px;
        }

        .pitch-center-circle {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80px;
            height: 80px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
        }

        .pitch-center-line {
            position: absolute;
            top: 50%;
            left: 20px;
            right: 20px;
            height: 2px;
            background: rgba(255, 255, 255, 0.3);
        }

        .player-slot {
            position: absolute;
            width: 60px;
            height: 75px;
            transform: translate(-50%, -50%);
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .player-slot:hover {
            transform: translate(-50%, -50%) scale(1.1);
        }

        .player-slot.filled .slot-circle {
            background: linear-gradient(135deg, var(--accent) 0%, #00ccff 100%);
        }

        .player-slot.current .slot-circle {
            animation: pulse 1.5s infinite;
            box-shadow: 0 0 20px var(--accent);
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .slot-circle {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.5);
            margin: 0 auto 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .slot-name {
            font-size: 0.65rem;
            color: white;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 70px;
        }

        .slot-rating {
            font-size: 0.6rem;
            color: var(--accent);
            font-weight: 700;
        }

        .slot-position {
            font-size: 0.55rem;
            color: rgba(255, 255, 255, 0.7);
        }

        /* Club Roll */
        .roll-section {
            background: linear-gradient(135deg, rgba(0, 51, 102, 0.6) 0%, rgba(0, 102, 153, 0.4) 100%);
            border-radius: 16px;
            padding: 30px;
            text-align: center;
            margin-bottom: 20px;
            border: 2px solid rgba(0, 212, 255, 0.3);
        }

        .roll-section h3 {
            margin-bottom: 20px;
            color: var(--text-secondary);
            font-weight: 700;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
            letter-spacing: 2px;
        }

        .club-display {
            font-size: 4rem;
            margin-bottom: 10px;
            transition: transform 0.3s ease;
        }

        .club-display.rolling {
            animation: spin 0.1s linear infinite;
        }

        @keyframes spin {
            from { transform: rotateY(0deg); }
            to { transform: rotateY(360deg); }
        }

        .club-name {
            font-size: 1.5rem;
            font-weight: 900;
            margin-bottom: 20px;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
            letter-spacing: 1px;
        }

        .roll-btn {
            padding: 15px 40px;
            font-size: 1.1rem;
            font-weight: 900;
            border: none;
            border-radius: 10px;
            background: var(--accent);
            color: #001845;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 5px;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
            text-transform: uppercase;
            letter-spacing: 2px;
            box-shadow: 0 4px 15px rgba(0, 212, 255, 0.3);
        }

        .roll-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 25px rgba(0, 212, 255, 0.5);
        }

        .roll-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .roll-btn.secondary {
            background: var(--warning);
        }

        /* Player Selection */
        .player-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .player-card {
            background: linear-gradient(135deg, rgba(0, 51, 102, 0.6) 0%, rgba(0, 102, 153, 0.4) 100%);
            border: 2px solid rgba(0, 212, 255, 0.3);
            border-radius: 12px;
            padding: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .player-card:hover {
            border-color: var(--accent);
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 212, 255, 0.3);
        }

        .player-card.selected {
            border-color: var(--accent);
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.2) 0%, rgba(0, 153, 204, 0.15) 100%);
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
        }

        .player-card .rating {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--accent);
            margin-bottom: 5px;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
        }

        .player-card .rating.hidden {
            color: var(--text-secondary);
        }

        .player-card .name {
            font-weight: 700;
            font-size: 0.95rem;
            margin-bottom: 3px;
            font-family: 'Oswald', sans-serif;
        }

        .player-card .position {
            font-size: 0.75rem;
            color: var(--text-secondary);
        }

        .player-card .position-penalty {
            font-size: 0.7rem;
            color: var(--danger);
            margin-top: 5px;
        }

        /* Simulation Screen */
        .sim-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .match-card {
            background: linear-gradient(135deg, rgba(0, 51, 102, 0.6) 0%, rgba(0, 102, 153, 0.4) 100%);
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 20px;
            animation: slideIn 0.5s ease;
            border: 2px solid rgba(0, 212, 255, 0.3);
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateX(-30px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .match-header {
            text-align: center;
            margin-bottom: 20px;
            color: var(--text-secondary);
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .match-teams {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .match-team {
            flex: 1;
            text-align: center;
        }

        .match-team .badge {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        .match-team .name {
            font-weight: 900;
            font-size: 1.1rem;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
            letter-spacing: 1px;
        }

        .match-team.user .name {
            color: var(--accent);
        }

        .match-score {
            font-size: 3rem;
            font-weight: 900;
            min-width: 120px;
            text-align: center;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
        }

        .match-events {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(0, 212, 255, 0.2);
        }

        .event {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 10px 0;
            font-size: 0.9rem;
            border-bottom: 1px solid rgba(0, 212, 255, 0.1);
        }

        .event:last-child {
            border-bottom: none;
        }

        .event .minute {
            color: var(--accent);
            font-weight: 700;
            min-width: 40px;
        }

        .event .icon {
            font-size: 1.2rem;
        }

        .event .detail {
            color: var(--text-secondary);
        }

        .event .player-name {
            color: var(--text-primary);
            font-weight: 600;
        }

        /* Commentary Box */
        .commentary-box {
            background: linear-gradient(135deg, rgba(0, 51, 102, 0.7) 0%, rgba(0, 102, 153, 0.5) 100%);
            border-radius: 12px;
            padding: 20px;
            margin-top: 15px;
            border-left: 4px solid var(--accent);
        }

        .commentary-box p {
            font-style: italic;
            color: var(--text-secondary);
            line-height: 1.6;
        }

        /* Results Screen */
        .trophy-display {
            text-align: center;
            padding: 40px;
        }

        .trophy {
            font-size: 8rem;
            margin-bottom: 20px;
            animation: bounce 1s ease infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        .result-title {
            font-size: 2.5rem;
            font-weight: 900;
            margin-bottom: 10px;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .result-title.winner {
            color: var(--gold);
        }

        .result-title.loser {
            color: var(--text-secondary);
        }

        .result-subtitle {
            color: var(--text-secondary);
            font-size: 1.2rem;
            margin-bottom: 30px;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
            margin: 30px 0;
        }

        .stat-card {
            background: linear-gradient(135deg, rgba(0, 51, 102, 0.6) 0%, rgba(0, 102, 153, 0.4) 100%);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            border: 2px solid rgba(0, 212, 255, 0.3);
        }

        .stat-card .label {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .stat-card .value {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--accent);
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
        }

        /* Match History */
        .match-history {
            margin-top: 30px;
        }

        .match-history h3 {
            margin-bottom: 20px;
            color: var(--text-secondary);
            font-weight: 700;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
            letter-spacing: 2px;
        }

        .history-item {
            background: linear-gradient(135deg, rgba(0, 51, 102, 0.6) 0%, rgba(0, 102, 153, 0.4) 100%);
            border-radius: 12px;
            padding: 15px 20px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid rgba(0, 212, 255, 0.2);
        }

        .history-item .round {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        .history-item .result {
            font-weight: 900;
            font-family: 'Bebas Neue', 'Oswald', sans-serif;
        }

        .history-item .result.win {
            color: var(--accent);
        }

        .history-item .result.loss {
            color: var(--danger);
        }

        /* Loading spinner */
        .loading {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px;
        }

        .spinner {
            width: 60px;
            height: 60px;
            border: 4px solid rgba(0, 212, 255, 0.3);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin-loader 1s linear infinite;
        }

        @keyframes spin-loader {
            to { transform: rotate(360deg); }
        }

        .loading p {
            margin-top: 20px;
            color: var(--text-secondary);
        }

        /* Responsive */
        @media (max-width: 600px) {
            .logo {
                font-size: 3rem;
            }
            
            .pitch-container {
                aspect-ratio: 2/3;
            }
            
            .player-slot {
                width: 50px;
                height: 65px;
            }
            
            .slot-circle {
                width: 35px;
                height: 35px;
                font-size: 0.75rem;
            }
            
            .slot-name {
                font-size: 0.55rem;
            }
            
            .match-score {
                font-size: 2rem;
                min-width: 80px;
            }
            
            .match-team .badge {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="header">
            <h1 class="logo">⭐ CHAMPIONS OF EUROPE ⭐</h1>
            <p class="subtitle">UEFA Champions League Dream Team</p>
        </header>

        <!-- Start Screen -->
        <div id="startScreen" class="screen active">
            <div class="start-options">
                <div class="option-group">
                    <h3>Select Difficulty</h3>
                    <div class="difficulty-buttons">
                        <button class="diff-btn easy selected" data-diff="easy">
                            <div class="name">Easy</div>
                            <div class="desc">3 Rerolls • See Ratings</div>
                        </button>
                        <button class="diff-btn medium" data-diff="medium">
                            <div class="name">Medium</div>
                            <div class="desc">1 Reroll • See Ratings</div>
                        </button>
                        <button class="diff-btn hard" data-diff="hard">
                            <div class="name">Hard</div>
                            <div class="desc">No Rerolls • Hidden Ratings</div>
                        </button>
                    </div>
                </div>

                <div class="option-group">
                    <h3>Player Ratings Based On</h3>
                    <div class="rating-buttons">
                        <button class="rating-btn selected" data-rating="tournament">
                            <div class="name">Competition Form</div>
                        </button>
                        <button class="rating-btn" data-rating="prime">
                            <div class="name">Prime Ratings</div>
                        </button>
                    </div>
                </div>

                <button class="main-btn" id="startGameBtn">Choose Tournament</button>
            </div>
        </div>

        <!-- Tournament Selection -->
        <div id="tournamentScreen" class="screen">
            <h2 style="text-align: center; margin-bottom: 30px; font-family: 'Bebas Neue', 'Oswald', sans-serif; letter-spacing: 2px; text-transform: uppercase;">Select Your European Cup Era</h2>
            <div class="tournament-grid" id="tournamentGrid"></div>
            <button class="main-btn" id="confirmTournamentBtn" disabled>Build Your Team</button>
        </div>

        <!-- Team Builder -->
        <div id="builderScreen" class="screen">
            <div class="builder-header">
                <div class="rerolls-display">
                    <div class="label">Rerolls Left</div>
                    <div class="value" id="rerollsLeft">3</div>
                </div>
                <div class="position-info">
                    <h2 id="currentPosition">Goalkeeper</h2>
                    <span id="positionCount">Position 1 of 11</span>
                </div>
                <div class="team-rating">
                    <div class="label">Team Rating</div>
                    <div class="value" id="teamRating">0</div>
                </div>
            </div>

            <div class="formation-selector">
                <h3>Formation</h3>
                <div class="formation-options" id="formationOptions"></div>
            </div>

            <div class="pitch-container" id="pitchContainer">
                <div class="pitch-lines"></div>
                <div class="pitch-center-circle"></div>
                <div class="pitch-center-line"></div>
            </div>

            <div class="roll-section" id="rollSection">
                <h3>Roll for Club</h3>
                <div class="club-display" id="clubBadge">⚽</div>
                <div class="club-name" id="clubName">Press Roll</div>
                <button class="roll-btn" id="rollClubBtn">🎲 Roll Club</button>
                <button class="roll-btn secondary" id="rerollBtn" style="display: none;">🔄 Reroll</button>
            </div>

            <div id="playerSelection" style="display: none;">
                <h3 style="margin-bottom: 15px; font-family: 'Bebas Neue', 'Oswald', sans-serif; letter-spacing: 2px; text-transform: uppercase;">Select a Player</h3>
                <div class="player-grid" id="playerGrid"></div>
                <button class="main-btn" id="confirmPlayerBtn" disabled>Confirm Selection</button>
            </div>
        </div>

        <!-- Simulation Screen -->
        <div id="simScreen" class="screen">
            <div class="sim-container">
                <div id="simContent"></div>
                <button class="main-btn" id="nextMatchBtn" style="display: none;">Next Match</button>
            </div>
        </div>

        <!-- Results Screen -->
        <div id="resultsScreen" class="screen">
            <div id="resultsContent"></div>
            <button class="main-btn" id="playAgainBtn">Play Again</button>
        </div>
    </div>

    <script>
        // Game data for Champions League eras
        const tournaments = [
            { id: 'european-cup-60s', name: 'European Cup Era (1960s)', badge: '🏆', years: '1960-1969', famous: 'Real Madrid' },
            { id: 'european-cup-70s', name: 'European Cup Era (1970s)', badge: '🏆', years: '1970-1979', famous: 'Bayern Munich' },
            { id: 'european-cup-80s', name: 'European Cup Era (1980s)', badge: '🏆', years: '1980-1989', famous: 'AC Milan' },
            { id: 'champions-league-90s', name: 'Champions League (1990s)', badge: '⭐', years: '1992-1999', famous: 'Manchester United' },
            { id: 'champions-league-2000s', name: 'Champions League (2000s)', badge: '⭐', years: '2000-2009', famous: 'AC Milan' },
            { id: 'champions-league-2010s', name: 'Champions League (2010s)', badge: '⭐', years: '2010-2019', famous: 'Barcelona' },
            { id: 'champions-league-2020s', name: 'Champions League (2020s)', badge: '⭐', years: '2020-2024', famous: 'Real Madrid' }
        ];

        const clubsDatabase = {
            'european-cup-60s': ['🇪🇸 Real Madrid', '🇮🇹 AC Milan', '🇬🇪 Eintracht Frankfurt', '🇵🇹 Benfica', '🇪🇸 Barcelona'],
            'european-cup-70s': ['🇩🇪 Bayern Munich', '🇮🇹 AC Milan', '🇮🇹 Inter Milan', '🇫🇷 Saint-Étienne', '🇳🇱 Ajax'],
            'european-cup-80s': ['🇮🇹 AC Milan', '🇩🇪 Hamburg', '🇳🇱 PSV Eindhoven', '🇬🇧 Nottingham Forest', '🇪🇸 Real Madrid'],
            'champions-league-90s': ['🇬🇧 Manchester United', '🇩🇪 Bayern Munich', '🇮🇹 AC Milan', '🇫🇷 Olympique Marseille', '🇪🇸 Real Madrid'],
            'champions-league-2000s': ['🇮🇹 AC Milan', '🇪🇸 Real Madrid', '🇮🇹 Inter Milan', '🇩🇪 Bayern Munich', '🇮🇹 Roma'],
            'champions-league-2010s': ['🇪🇸 Barcelona', '🇬🇧 Manchester United', '🇩🇪 Bayern Munich', '🇮🇹 AC Milan', '🇪🇸 Real Madrid'],
            'champions-league-2020s': ['🇪🇸 Real Madrid', '🇫🇷 Paris Saint-Germain', '🇬🇧 Manchester City', '🇬🇧 Liverpool', '🇩🇪 Bayern Munich']
        };

        // Player database with positions
        const playerDatabase = {
            'goalkeeper': [
                { name: 'Buffon', rating: 95, position: 'GK' },
                { name: 'Neuer', rating: 96, position: 'GK' },
                { name: 'van der Sar', rating: 93, position: 'GK' },
                { name: 'Casillas', rating: 92, position: 'GK' },
                { name: 'Yashin', rating: 91, position: 'GK' },
                { name: 'De Sanctis', rating: 84, position: 'GK' },
                { name: 'Reina', rating: 85, position: 'GK' },
                { name: 'Handanovic', rating: 83, position: 'GK' }
            ],
            'defender': [
                { name: 'Maldini', rating: 97, position: 'DEF' },
                { name: 'Ramos', rating: 96, position: 'DEF' },
                { name: 'Beckenbauer', rating: 97, position: 'DEF' },
                { name: 'Baresi', rating: 95, position: 'DEF' },
                { name: 'Cannavaro', rating: 93, position: 'DEF' },
                { name: 'Nesta', rating: 91, position: 'DEF' },
                { name: 'van Dijk', rating: 94, position: 'DEF' },
                { name: 'Carvalho', rating: 90, position: 'DEF' }
            ],
            'midfielder': [
                { name: 'Zidane', rating: 98, position: 'MID' },
                { name: 'Iniesta', rating: 97, position: 'MID' },
                { name: 'Gerrard', rating: 94, position: 'MID' },
                { name: 'Scholes', rating: 92, position: 'MID' },
                { name: 'Pirlo', rating: 96, position: 'MID' },
                { name: 'Xavi', rating: 97, position: 'MID' },
                { name: 'Seedorf', rating: 93, position: 'MID' },
                { name: 'Totti', rating: 94, position: 'MID' }
            ],
            'forward': [
                { name: 'Messi', rating: 99, position: 'FWD' },
                { name: 'Ronaldo', rating: 99, position: 'FWD' },
                { name: 'Maradona', rating: 98, position: 'FWD' },
                { name: 'Ronaldinho', rating: 97, position: 'FWD' },
                { name: 'Cristiano', rating: 98, position: 'FWD' },
                { name: 'Platini', rating: 94, position: 'FWD' },
                { name: 'Van Basten', rating: 96, position: 'FWD' },
                { name: 'Gerd Müller', rating: 95, position: 'FWD' }
            ]
        };

        const formations = {
            '4-4-2': { positions: ['goalkeeper', 'defender', 'defender', 'defender', 'defender', 'midfielder', 'midfielder', 'midfielder', 'midfielder', 'forward', 'forward'], slots: [{ x: 50, y: 10 }, { x: 15, y: 30 }, { x: 50, y: 30 }, { x: 85, y: 30 }, { x: 50, y: 50 }, { x: 20, y: 60 }, { x: 35, y: 70 }, { x: 65, y: 70 }, { x: 80, y: 60 }, { x: 30, y: 85 }, { x: 70, y: 85 }] },
            '3-5-2': { positions: ['goalkeeper', 'defender', 'defender', 'defender', 'midfielder', 'midfielder', 'midfielder', 'midfielder', 'midfielder', 'forward', 'forward'], slots: [{ x: 50, y: 10 }, { x: 25, y: 30 }, { x: 50, y: 30 }, { x: 75, y: 30 }, { x: 15, y: 55 }, { x: 35, y: 65 }, { x: 50, y: 70 }, { x: 65, y: 65 }, { x: 85, y: 55 }, { x: 35, y: 85 }, { x: 65, y: 85 }] },
            '5-3-2': { positions: ['goalkeeper', 'defender', 'defender', 'defender', 'defender', 'defender', 'midfielder', 'midfielder', 'midfielder', 'forward', 'forward'], slots: [{ x: 50, y: 10 }, { x: 15, y: 25 }, { x: 35, y: 30 }, { x: 50, y: 35 }, { x: 65, y: 30 }, { x: 85, y: 25 }, { x: 25, y: 65 }, { x: 50, y: 70 }, { x: 75, y: 65 }, { x: 35, y: 85 }, { x: 65, y: 85 }] }
        };

        let gameState = {
            difficulty: 'easy',
            ratingType: 'tournament',
            selectedTournament: null,
            selectedFormation: '4-4-2',
            team: [],
            club: null,
            rerolls: 3,
            currentPositionIndex: 0,
            tournamentMatches: [],
            matchResults: []
        };

        // Helper functions
        function showScreen(screenId) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(screenId).classList.add('active');
        }

        // Start screen handlers
        document.querySelectorAll('.diff-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('selected'));
                this.classList.add('selected');
                gameState.difficulty = this.dataset.diff;
                gameState.rerolls = this.dataset.diff === 'easy' ? 3 : this.dataset.diff === 'medium' ? 1 : 0;
            });
        });

        document.querySelectorAll('.rating-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.rating-btn').forEach(b => b.classList.remove('selected'));
                this.classList.add('selected');
                gameState.ratingType = this.dataset.rating;
            });
        });

        document.getElementById('startGameBtn').addEventListener('click', () => {
            const grid = document.getElementById('tournamentGrid');
            grid.innerHTML = '';
            tournaments.forEach(tournament => {
                const card = document.createElement('div');
                card.className = 'tournament-card';
                card.innerHTML = `
                    <div class="tournament-badge">${tournament.badge}</div>
                    <div class="tournament-info">
                        <h4>${tournament.name}</h4>
                        <span>${tournament.years}</span>
                        <span>Featured: ${tournament.famous}</span>
                    </div>
                `;
                card.addEventListener('click', () => {
                    document.querySelectorAll('.tournament-card').forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    gameState.selectedTournament = tournament.id;
                    document.getElementById('confirmTournamentBtn').disabled = false;
                });
                grid.appendChild(card);
            });
            showScreen('tournamentScreen');
        });

        document.getElementById('confirmTournamentBtn').addEventListener('click', () => {
            gameState.team = [];
            gameState.currentPositionIndex = 0;
            const formationOptions = document.getElementById('formationOptions');
            formationOptions.innerHTML = '';
            Object.keys(formations).forEach(formation => {
                const btn = document.createElement('button');
                btn.className = 'formation-btn' + (formation === gameState.selectedFormation ? ' selected' : '');
                btn.textContent = formation;
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.formation-btn').forEach(b => b.classList.remove('selected'));
                    btn.classList.add('selected');
                    gameState.selectedFormation = formation;
                    renderPitch();
                });
                formationOptions.appendChild(btn);
            });
            renderPitch();
            showScreen('builderScreen');
        });

        function renderPitch() {
            const container = document.getElementById('pitchContainer');
            const formation = formations[gameState.selectedFormation];
            container.querySelectorAll('.player-slot').forEach(s => s.remove());
            
            formation.slots.forEach((slot, index) => {
                const playerSlot = document.createElement('div');
                playerSlot.className = 'player-slot' + (index === gameState.currentPositionIndex ? ' current' : '') + (gameState.team[index] ? ' filled' : '');
                const player = gameState.team[index];
                playerSlot.innerHTML = `
                    <div class="slot-circle">${player ? '✓' : index + 1}</div>
                    ${player ? `<div class="slot-name">${player.name}</div><div class="slot-rating">${player.rating}</div>` : ''}
                `;
                playerSlot.style.left = slot.x + '%';
                playerSlot.style.top = slot.y + '%';
                playerSlot.addEventListener('click', () => {
                    gameState.currentPositionIndex = index;
                    rollClub();
                });
                container.appendChild(playerSlot);
            });

            const formation_obj = formations[gameState.selectedFormation];
            const currentPos = formation_obj.positions[gameState.currentPositionIndex];
            document.getElementById('currentPosition').textContent = currentPos.charAt(0).toUpperCase() + currentPos.slice(1).toLowerCase();
            document.getElementById('positionCount').textContent = `Position ${gameState.currentPositionIndex + 1} of ${formation_obj.positions.length}`;
            updateTeamRating();
        }

        function updateTeamRating() {
            const rating = gameState.team.reduce((sum, player) => sum + (player ? player.rating : 0), 0);
            document.getElementById('teamRating').textContent = rating;
            document.getElementById('rerollsLeft').textContent = gameState.rerolls;
        }

        function rollClub() {
            const clubs = clubsDatabase[gameState.selectedTournament];
            const randomClub = clubs[Math.floor(Math.random() * clubs.length)];
            gameState.club = randomClub;
            
            const badge = document.getElementById('clubBadge');
            badge.classList.add('rolling');
            setTimeout(() => {
                badge.classList.remove('rolling');
                document.getElementById('clubName').textContent = randomClub;
                showPlayerSelection();
            }, 600);
        }

        function showPlayerSelection() {
            const formation = formations[gameState.selectedFormation];
            const position = formation.positions[gameState.currentPositionIndex];
            const players = playerDatabase[position] || [];
            
            const grid = document.getElementById('playerGrid');
            grid.innerHTML = '';
            
            players.forEach(player => {
                const card = document.createElement('div');
                card.className = 'player-card';
                const rating = gameState.ratingType === 'tournament' ? player.rating : Math.floor(Math.random() * 20 + 80);
                const showRating = gameState.difficulty !== 'hard';
                
                card.innerHTML = `
                    <div class="rating${!showRating ? ' hidden' : ''}">${showRating ? rating : '?'}</div>
                    <div class="name">${player.name}</div>
                    <div class="position">${player.position}</div>
                `;
                
                card.addEventListener('click', () => {
                    document.querySelectorAll('.player-card').forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    window.selectedPlayer = { ...player, rating: showRating ? rating : player.rating };
                    document.getElementById('confirmPlayerBtn').disabled = false;
                });
                
                grid.appendChild(card);
            });
            
            document.getElementById('playerSelection').style.display = 'block';
            document.getElementById('rollSection').style.display = 'none';
        }

        document.getElementById('rollClubBtn').addEventListener('click', rollClub);
        document.getElementById('rerollBtn').addEventListener('click', () => {
            if (gameState.rerolls > 0) {
                gameState.rerolls--;
                rollClub();
            }
        });

        document.getElementById('confirmPlayerBtn').addEventListener('click', () => {
            if (window.selectedPlayer) {
                gameState.team[gameState.currentPositionIndex] = window.selectedPlayer;
                const formation = formations[gameState.selectedFormation];
                
                if (gameState.currentPositionIndex < formation.positions.length - 1) {
                    gameState.currentPositionIndex++;
                    document.getElementById('playerSelection').style.display = 'none';
                    document.getElementById('rollSection').style.display = 'block';
                    renderPitch();
                    rollClub();
                } else {
                    startTournament();
                }
            }
        });

        function startTournament() {
            gameState.tournamentMatches = [];
            gameState.matchResults = [];
            
            // Generate tournament matches (Semi-final, Final)
            const opponents = [
                { name: 'Barcelona', rating: 92, badge: '🔵' },
                { name: 'Real Madrid', rating: 93, badge: '👑' },
                { name: 'Bayern Munich', rating: 91, badge: '🔴' }
            ];
            
            gameState.tournamentMatches = [
                { opponent: opponents[0], round: 'Semi-Final' },
                { opponent: opponents[1], round: 'Final' }
            ];
            
            playMatch(0);
        }

        function playMatch(matchIndex) {
            if (matchIndex >= gameState.tournamentMatches.length) {
                showResults();
                return;
            }
            
            const match = gameState.tournamentMatches[matchIndex];
            const userRating = gameState.team.reduce((sum, p) => sum + (p ? p.rating : 0), 0);
            const opponentRating = match.opponent.rating * 11;
            
            const userGoals = Math.floor(Math.random() * 3 + Math.floor(userRating / 30));
            const opponentGoals = Math.floor(Math.random() * 3 + Math.floor(opponentRating / 30));
            
            const result = {
                round: match.round,
                opponent: match.opponent.name,
                userGoals,
                opponentGoals,
                won: userGoals > opponentGoals,
                draw: userGoals === opponentGoals
            };
            
            gameState.matchResults.push(result);
            
            const content = document.getElementById('simContent');
            content.innerHTML = `
                <div class="match-card">
                    <div class="match-header">${match.round}</div>
                    <div class="match-teams">
                        <div class="match-team user">
                            <div class="badge">⚽</div>
                            <div class="name">Your Team</div>
                        </div>
                        <div class="match-score">${userGoals} - ${opponentGoals}</div>
                        <div class="match-team">
                            <div class="badge">${match.opponent.badge}</div>
                            <div class="name">${match.opponent.name}</div>
                        </div>
                    </div>
                    <div class="match-events">
                        <div class="event">
                            <span class="minute">45'</span>
                            <span class="icon">⚽</span>
                            <span class="detail">Your Team</span>
                        </div>
                        <div class="event">
                            <span class="minute">67'</span>
                            <span class="icon">⚽</span>
                            <span class="detail">${match.opponent.name}</span>
                        </div>
                    </div>
                    <div class="commentary-box">
                        <p>${result.won ? '🎉 Excellent performance! Your team dominated the match.' : result.draw ? '⚖️ A closely contested match that ended in a draw.' : '😟 A tough performance, better luck next time.'}</p>
                    </div>
                </div>
            `;
            
            showScreen('simScreen');
            
            if (result.won && matchIndex < gameState.tournamentMatches.length - 1) {
                document.getElementById('nextMatchBtn').style.display = 'block';
                document.getElementById('nextMatchBtn').onclick = () => playMatch(matchIndex + 1);
            } else if (!result.won) {
                document.getElementById('nextMatchBtn').textContent = 'See Results';
                document.getElementById('nextMatchBtn').style.display = 'block';
                document.getElementById('nextMatchBtn').onclick = showResults;
            } else {
                document.getElementById('nextMatchBtn').style.display = 'none';
                setTimeout(showResults, 3000);
            }
        }

        function showResults() {
            const won = gameState.matchResults.every(m => m.won);
            const finalMatch = gameState.matchResults[gameState.matchResults.length - 1];
            
            const statsGrid = `
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="label">Matches Played</div>
                        <div class="value">${gameState.matchResults.length}</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Wins</div>
                        <div class="value">${gameState.matchResults.filter(m => m.won).length}</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Team Rating</div>
                        <div class="value">${gameState.team.reduce((sum, p) => sum + (p ? p.rating : 0), 0)}</div>
                    </div>
                </div>
            `;
            
            const historyItems = gameState.matchResults.map(result => `
                <div class="history-item">
                    <div class="round">${result.round} vs ${result.opponent}</div>
                    <div class="result ${result.won ? 'win' : 'loss'}">${result.userGoals} - ${result.opponentGoals}</div>
                </div>
            `).join('');
            
            document.getElementById('resultsContent').innerHTML = `
                <div class="trophy-display">
                    <div class="trophy">${won ? '🏆' : '🥈'}</div>
                    <h1 class="result-title ${won ? 'winner' : 'loser'}">${won ? 'Champions! 🎉' : 'Tournament Over'}</h1>
                    <p class="result-subtitle">${won ? 'You are the Champions of Europe!' : `You made it to the ${finalMatch.round}`}</p>
                </div>
                ${statsGrid}
                <div class="match-history">
                    <h3>Match History</h3>
                    ${historyItems}
                </div>
            `;
            
            showScreen('resultsScreen');
        }

        document.getElementById('playAgainBtn').addEventListener('click', () => {
            gameState = {
                difficulty: 'easy',
                ratingType: 'tournament',
                selectedTournament: null,
                selectedFormation: '4-4-2',
                team: [],
                club: null,
                rerolls: 3,
                currentPositionIndex: 0,
                tournamentMatches: [],
                matchResults: []
            };
            showScreen('startScreen');
        });
    </script>
</body>
</html>