<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Champions of Europe | Dream Team Builder</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-dark: #0a0a0f;
            --bg-card: #12121a;
            --bg-hover: #1a1a25;
            --accent: #00ff88;
            --accent-dim: #00cc6a;
            --gold: #ffd700;
            --silver: #c0c0c0;
            --bronze: #cd7f32;
            --text-primary: #ffffff;
            --text-secondary: #8888aa;
            --danger: #ff4757;
            --warning: #ffa502;
        }

        body {
            font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg-dark);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Header */
        .header {
            text-align: center;
            padding: 40px 20px;
            position: relative;
        }

        .logo {
            font-size: 4rem;
            font-weight: 900;
            letter-spacing: -3px;
            background: linear-gradient(135deg, var(--accent) 0%, #00ccff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 60px rgba(0, 255, 136, 0.3);
        }

        .subtitle {
            color: var(--text-secondary);
            font-size: 1.1rem;
            margin-top: 10px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* Screens */
        .screen {
            display: none;
            animation: fadeIn 0.4s ease;
        }

        .screen.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Start Screen */
        .start-options {
            display: flex;
            flex-direction: column;
            gap: 30px;
            max-width: 600px;
            margin: 0 auto;
        }

        .option-group {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 25px;
            border: 1px solid #222;
        }

        .option-group h3 {
            color: var(--accent);
            margin-bottom: 15px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .difficulty-buttons, .rating-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .diff-btn, .rating-btn {
            flex: 1;
            min-width: 120px;
            padding: 20px 15px;
            border: 2px solid #333;
            background: var(--bg-dark);
            color: var(--text-primary);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .diff-btn:hover, .rating-btn:hover {
            border-color: var(--accent);
            background: var(--bg-hover);
        }

        .diff-btn.selected, .rating-btn.selected {
            border-color: var(--accent);
            background: rgba(0, 255, 136, 0.1);
        }

        .diff-btn .name, .rating-btn .name {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        .diff-btn .desc {
            font-size: 0.75rem;
            color: var(--text-secondary);
            line-height: 1.4;
        }

        .easy .name { color: #00ff88; }
        .medium .name { color: #ffa502; }
        .hard .name { color: #ff4757; }

        /* Tournament Selection */
        .tournament-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .tournament-card {
            background: var(--bg-card);
            border: 2px solid #222;
            border-radius: 16px;
            padding: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .tournament-card:hover {
            border-color: var(--accent);
            transform: translateY(-3px);
        }

        .tournament-card.selected {
            border-color: var(--accent);
            background: rgba(0, 255, 136, 0.05);
        }

        .tournament-badge {
            font-size: 2.5rem;
        }

        .tournament-info h4 {
            font-size: 1.1rem;
            margin-bottom: 5px;
        }

        .tournament-info span {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        /* Main Button */
        .main-btn {
            display: block;
            width: 100%;
            max-width: 400px;
            margin: 30px auto;
            padding: 20px 40px;
            font-size: 1.2rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--accent) 0%, #00ccff 100%);
            color: var(--bg-dark);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .main-btn:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 40px rgba(0, 255, 136, 0.3);
        }

        .main-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        /* Team Builder */
        .builder-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .position-info {
            text-align: center;
        }

        .position-info h2 {
            font-size: 1.5rem;
            color: var(--accent);
        }

        .position-info span {
            color: var(--text-secondary);
        }

        .team-rating {
            background: var(--bg-card);
            padding: 15px 25px;
            border-radius: 12px;
            text-align: center;
        }

        .team-rating .label {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
        }

        .team-rating .value {
            font-size: 2rem;
            font-weight: 900;
            color: var(--accent);
        }

        .rerolls-display {
            background: var(--bg-card);
            padding: 15px 25px;
            border-radius: 12px;
            text-align: center;
        }

        .rerolls-display .label {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
        }

        .rerolls-display .value {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--warning);
        }

        /* Formation Display */
        .formation-selector {
            margin-bottom: 30px;
        }

        .formation-selector h3 {
            margin-bottom: 15px;
            color: var(--text-secondary);
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .formation-options {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .formation-btn {
            padding: 10px 20px;
            border: 2px solid #333;
            background: var(--bg-dark);
            color: var(--text-primary);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 600;
        }

        .formation-btn:hover {
            border-color: var(--accent);
        }

        .formation-btn.selected {
            border-color: var(--accent);
            background: rgba(0, 255, 136, 0.1);
            color: var(--accent);
        }

        /* Pitch Display */
        .pitch-container {
            background: linear-gradient(to bottom, #1a4d1a 0%, #2d5a2d 50%, #1a4d1a 100%);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 30px;
            position: relative;
            aspect-ratio: 3/4;
            max-height: 500px;
            overflow: hidden;
        }

        .pitch-lines {
            position: absolute;
            inset: 20px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 8px;
        }

        .pitch-center-circle {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80px;
            height: 80px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
        }

        .pitch-center-line {
            position: absolute;
            top: 50%;
            left: 20px;
            right: 20px;
            height: 2px;
            background: rgba(255, 255, 255, 0.3);
        }

        .player-slot {
            position: absolute;
            width: 60px;
            height: 75px;
            transform: translate(-50%, -50%);
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .player-slot:hover {
            transform: translate(-50%, -50%) scale(1.1);
        }

        .player-slot.filled .slot-circle {
            background: linear-gradient(135deg, var(--accent) 0%, #00ccff 100%);
        }

        .player-slot.current .slot-circle {
            animation: pulse 1.5s infinite;
            box-shadow: 0 0 20px var(--accent);
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .slot-circle {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.5);
            margin: 0 auto 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .slot-name {
            font-size: 0.65rem;
            color: white;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 70px;
        }

        .slot-rating {
            font-size: 0.6rem;
            color: var(--accent);
            font-weight: 700;
        }

        .slot-position {
            font-size: 0.55rem;
            color: rgba(255, 255, 255, 0.7);
        }

        /* Club Roll */
        .roll-section {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 30px;
            text-align: center;
            margin-bottom: 20px;
        }

        .roll-section h3 {
            margin-bottom: 20px;
            color: var(--text-secondary);
        }

        .club-display {
            font-size: 4rem;
            margin-bottom: 10px;
            transition: transform 0.3s ease;
        }

        .club-display.rolling {
            animation: spin 0.1s linear infinite;
        }

        @keyframes spin {
            from { transform: rotateY(0deg); }
            to { transform: rotateY(360deg); }
        }

        .club-name {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .roll-btn {
            padding: 15px 40px;
            font-size: 1.1rem;
            font-weight: 700;
            border: none;
            border-radius: 10px;
            background: var(--accent);
            color: var(--bg-dark);
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 5px;
        }

        .roll-btn:hover {
            transform: scale(1.05);
        }

        .roll-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .roll-btn.secondary {
            background: var(--warning);
        }

        /* Player Selection */
        .player-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .player-card {
            background: var(--bg-card);
            border: 2px solid #333;
            border-radius: 12px;
            padding: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .player-card:hover {
            border-color: var(--accent);
            transform: translateY(-3px);
        }

        .player-card.selected {
            border-color: var(--accent);
            background: rgba(0, 255, 136, 0.1);
        }

        .player-card .rating {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--accent);
            margin-bottom: 5px;
        }

        .player-card .rating.hidden {
            color: var(--text-secondary);
        }

        .player-card .name {
            font-weight: 600;
            font-size: 0.95rem;
            margin-bottom: 3px;
        }

        .player-card .position {
            font-size: 0.75rem;
            color: var(--text-secondary);
        }

        .player-card .position-penalty {
            font-size: 0.7rem;
            color: var(--danger);
            margin-top: 5px;
        }

        /* Simulation Screen */
        .sim-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .match-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 20px;
            animation: slideIn 0.5s ease;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateX(-30px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .match-header {
            text-align: center;
            margin-bottom: 20px;
            color: var(--text-secondary);
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .match-teams {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .match-team {
            flex: 1;
            text-align: center;
        }

        .match-team .badge {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        .match-team .name {
            font-weight: 700;
            font-size: 1.1rem;
        }

        .match-team.user .name {
            color: var(--accent);
        }

        .match-score {
            font-size: 3rem;
            font-weight: 900;
            min-width: 120px;
            text-align: center;
        }

        .match-events {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #333;
        }

        .event {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 10px 0;
            font-size: 0.9rem;
            border-bottom: 1px solid #222;
        }

        .event:last-child {
            border-bottom: none;
        }

        .event .minute {
            color: var(--accent);
            font-weight: 700;
            min-width: 40px;
        }

        .event .icon {
            font-size: 1.2rem;
        }

        .event .detail {
            color: var(--text-secondary);
        }

        .event .player-name {
            color: var(--text-primary);
            font-weight: 600;
        }

        /* Commentary Box */
        .commentary-box {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            border-radius: 12px;
            padding: 20px;
            margin-top: 15px;
            border-left: 4px solid var(--accent);
        }

        .commentary-box p {
            font-style: italic;
            color: var(--text-secondary);
            line-height: 1.6;
        }

        /* Results Screen */
        .trophy-display {
            text-align: center;
            padding: 40px;
        }

        .trophy {
            font-size: 8rem;
            margin-bottom: 20px;
            animation: bounce 1s ease infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        .result-title {
            font-size: 2.5rem;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .result-title.winner {
            color: var(--gold);
        }

        .result-title.loser {
            color: var(--text-secondary);
        }

        .result-subtitle {
            color: var(--text-secondary);
            font-size: 1.2rem;
            margin-bottom: 30px;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
            margin: 30px 0;
        }

        .stat-card {
            background: var(--bg-card);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
        }

        .stat-card .label {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .stat-card .value {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--accent);
        }

        /* Match History */
        .match-history {
            margin-top: 30px;
        }

        .match-history h3 {
            margin-bottom: 20px;
            color: var(--text-secondary);
        }

        .history-item {
            background: var(--bg-card);
            border-radius: 12px;
            padding: 15px 20px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .history-item .round {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        .history-item .result {
            font-weight: 700;
        }

        .history-item .result.win {
            color: var(--accent);
        }

        .history-item .result.loss {
            color: var(--danger);
        }

        /* Loading spinner */
        .loading {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px;
        }

        .spinner {
            width: 60px;
            height: 60px;
            border: 4px solid #333;
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin-loader 1s linear infinite;
        }

        @keyframes spin-loader {
            to { transform: rotate(360deg); }
        }

        .loading p {
            margin-top: 20px;
            color: var(--text-secondary);
        }

        /* Responsive */
        @media (max-width: 600px) {
            .logo {
                font-size: 3rem;
            }
            
            .pitch-container {
                aspect-ratio: 2/3;
            }
            
            .player-slot {
                width: 50px;
                height: 65px;
            }
            
            .slot-circle {
                width: 35px;
                height: 35px;
                font-size: 0.75rem;
            }
            
            .slot-name {
                font-size: 0.55rem;
            }
            
            .match-score {
                font-size: 2rem;
                min-width: 80px;
            }
            
            .match-team .badge {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="header">
            <h1 class="logo">⭐ CHAMPIONS OF EUROPE ⭐</h1>
            <p class="subtitle">UEFA Champions League Dream Team</p>
        </header>

        <!-- Start Screen -->
        <div id="startScreen" class="screen active">
            <div class="start-options">
                <div class="option-group">
                    <h3>Select Difficulty</h3>
                    <div class="difficulty-buttons">
                        <button class="diff-btn easy selected" data-diff="easy">
                            <div class="name">Easy</div>
                            <div class="desc">3 Rerolls • See Ratings</div>
                        </button>
                        <button class="diff-btn medium" data-diff="medium">
                            <div class="name">Medium</div>
                            <div class="desc">1 Reroll • See Ratings</div>
                        </button>
                        <button class="diff-btn hard" data-diff="hard">
                            <div class="name">Hard</div>
                            <div class="desc">No Rerolls • Hidden Ratings</div>
                        </button>
                    </div>
                </div>

                <div class="option-group">
                    <h3>Player Ratings Based On</h3>
                    <div class="rating-buttons">
                        <button class="rating-btn selected" data-rating="tournament">
                            <div class="name">Competition Form</div>
                        </button>
                        <button class="rating-btn" data-rating="prime">
                            <div class="name">Prime Ratings</div>
                        </button>
                    </div>
                </div>

                <button class="main-btn" id="startGameBtn">Choose Tournament</button>
            </div>
        </div>

        <!-- Tournament Selection -->
        <div id="tournamentScreen" class="screen">
            <h2 style="text-align: center; margin-bottom: 30px;">Select Your European Cup Era</h2>
            <div class="tournament-grid" id="tournamentGrid"></div>
            <button class="main-btn" id="confirmTournamentBtn" disabled>Build Your Team</button>
        </div>

        <!-- Team Builder -->
        <div id="builderScreen" class="screen">
            <div class="builder-header">
                <div class="rerolls-display">
                    <div class="label">Rerolls Left</div>
                    <div class="value" id="rerollsLeft">3</div>
                </div>
                <div class="position-info">
                    <h2 id="currentPosition">Goalkeeper</h2>
                    <span id="positionCount">Position 1 of 11</span>
                </div>
                <div class="team-rating">
                    <div class="label">Team Rating</div>
                    <div class="value" id="teamRating">0</div>
                </div>
            </div>

            <div class="formation-selector">
                <h3>Formation</h3>
                <div class="formation-options" id="formationOptions"></div>
            </div>

            <div class="pitch-container" id="pitchContainer">
                <div class="pitch-lines"></div>
                <div class="pitch-center-circle"></div>
                <div class="pitch-center-line"></div>
            </div>

            <div class="roll-section" id="rollSection">
                <h3>Roll for Club</h3>
                <div class="club-display" id="clubBadge">⚽</div>
                <div class="club-name" id="clubName">Press Roll</div>
                <button class="roll-btn" id="rollClubBtn">🎲 Roll Club</button>
                <button class="roll-btn secondary" id="rerollBtn" style="display: none;">🔄 Reroll</button>
            </div>

            <div id="playerSelection" style="display: none;">
                <h3 style="margin-bottom: 15px;">Select a Player</h3>
                <div class="player-grid" id="playerGrid"></div>
                <button class="main-btn" id="confirmPlayerBtn" disabled>Confirm Selection</button>
            </div>
        </div>

        <!-- Simulation Screen -->
        <div id="simScreen" class="screen">
            <div class="sim-container">
                <div id="simContent"></div>
                <button class="main-btn" id="nextMatchBtn" style="display: none;">Next Match</button>
            </div>
        </div>

        <!-- Results Screen -->
        <div id="resultsScreen" class="screen">
            <div id="resultsContent"></div>
            <button class="main-btn" id="playAgainBtn">Play Again</button>
        </div>
    </div>

    <script>
        // Game data for Champions League eras
        const tournaments = [
            { id: 'european-cup-60s', name: 'European Cup Era (1960s)', badge: '🏆', years: '1960-1969', famous: 'Real Madrid' },
            { id: 'european-cup-70s', name: 'European Cup Era (1970s)', badge: '🏆', years: '1970-1979', famous: 'Bayern Munich' },
            { id: 'european-cup-80s', name: 'European Cup Era (1980s)', badge: '🏆', years: '1980-1989', famous: 'AC Milan' },
            { id: 'champions-league-90s', name: 'Champions League (1990s)', badge: '⭐', years: '1992-1999', famous: 'Manchester United' },
            { id: 'champions-league-2000s', name: 'Champions League (2000s)', badge: '⭐', years: '2000-2009', famous: 'AC Milan' },
            { id: 'champions-league-2010s', name: 'Champions League (2010s)', badge: '⭐', years: '2010-2019', famous: 'Barcelona' },
            { id: 'champions-league-2020s', name: 'Champions League (2020s)', badge: '⭐', years: '2020-2024', famous: 'Real Madrid' }
        ];

        const clubsDatabase = {
            'european-cup-60s': ['🇪🇸 Real Madrid', '🇮🇹 AC Milan', '🇬🇪 Eintracht Frankfurt', '🇵🇹 Benfica', '🇪🇸 Barcelona'],
            'european-cup-70s': ['🇩🇪 Bayern Munich', '🇮🇹 AC Milan', '🇮🇹 Inter Milan', '🇫🇷 Saint-Étienne', '🇳🇱 Ajax'],
            'european-cup-80s': ['🇮🇹 AC Milan', '🇩🇪 Hamburg', '🇳🇱 PSV Eindhoven', '🇬🇧 Nottingham Forest', '🇪🇸 Real Madrid'],
            'champions-league-90s': ['🇬🇧 Manchester United', '🇩🇪 Bayern Munich', '🇮🇹 AC Milan', '🇫🇷 Olympique Marseille', '🇪🇸 Real Madrid'],
            'champions-league-2000s': ['🇮🇹 AC Milan', '🇪🇸 Real Madrid', '🇮🇹 Inter Milan', '🇩🇪 Bayern Munich', '🇮🇹 Roma'],
            'champions-league-2010s': ['🇪🇸 Barcelona', '🇬🇧 Manchester United', '🇩🇪 Bayern Munich', '🇮🇹 AC Milan', '🇪🇸 Real Madrid'],
            'champions-league-2020s': ['🇪🇸 Real Madrid', '🇫🇷 Paris Saint-Germain', '🇬🇧 Manchester City', '🇬🇧 Liverpool', '🇩🇪 Bayern Munich']
        };

        // Player database with positions
        const playerDatabase = {
            'goalkeeper': [
                { name: 'Buffon', rating: 95, position: 'GK' },
                { name: 'Neuer', rating: 96, position: 'GK' },
                { name: 'van der Sar', rating: 93, position: 'GK' },
                { name: 'Casillas', rating: 92, position: 'GK' },
                { name: 'Yashin', rating: 91, position: 'GK' },
                { name: 'De Sanctis', rating: 84, position: 'GK' },
                { name: 'Reina', rating: 85, position: 'GK' },
                { name: 'Handanovic', rating: 83, position: 'GK' }
            ],
            'defender': [
                { name: 'Maldini', rating: 97, position: 'DEF' },
                { name: 'Ramos', rating: 96, position: 'DEF' },
                { name: 'Beckenbauer', rating: 97, position: 'DEF' },
                { name: 'Baresi', rating: 95, position: 'DEF' },
                { name: 'Cannavaro', rating: 93, position: 'DEF' },
                { name: 'Nesta', rating: 91, position: 'DEF' },
                { name: 'van Dijk', rating: 94, position: 'DEF' },
                { name: 'Carvalho', rating: 90, position: 'DEF' }
            ],
            'midfielder': [
                { name: 'Zidane', rating: 98, position: 'MID' },
                { name: 'Iniesta', rating: 97, position: 'MID' },
                { name: 'Gerrard', rating: 94, position: 'MID' },
                { name: 'Scholes', rating: 92, position: 'MID' },
                { name: 'Pirlo', rating: 96, position: 'MID' },
                { name: 'Xavi', rating: 97, position: 'MID' },
                { name: 'Seedorf', rating: 93, position: 'MID' },
                { name: 'Totti', rating: 94, position: 'MID' }
            ],
            'forward': [
                { name: 'Messi', rating: 99, position: 'FWD' },
                { name: 'Ronaldo', rating: 99, position: 'FWD' },
                { name: 'Maradona', rating: 98, position: 'FWD' },
                { name: 'Ronaldinho', rating: 97, position: 'FWD' },
                { name: 'Cristiano', rating: 98, position: 'FWD' },
                { name: 'Platini', rating: 94, position: 'FWD' },
                { name: 'Van Basten', rating: 96, position: 'FWD' },
                { name: 'Gerd Müller', rating: 95, position: 'FWD' }
            ]
        };

        const formations = {
            '4-4-2': { positions: ['goalkeeper', 'defender', 'defender', 'defender', 'defender', 'midfielder', 'midfielder', 'midfielder', 'midfielder', 'forward', 'forward'], slots: [{ x: 50, y: 10 }, { x: 20, y: 30 }, { x: 40, y: 30 }, { x: 60, y: 30 }, { x: 80, y: 30 }, { x: 15, y: 55 }, { x: 40, y: 55 }, { x: 60, y: 55 }, { x: 85, y: 55 }, { x: 30, y: 80 }, { x: 70, y: 80 }] },
            '3-5-2': { positions: ['goalkeeper', 'defender', 'defender', 'defender', 'midfielder', 'midfielder', 'midfielder', 'midfielder', 'midfielder', 'forward', 'forward'], slots: [{ x: 50, y: 10 }, { x: 25, y: 30 }, { x: 50, y: 30 }, { x: 75, y: 30 }, { x: 10, y: 55 }, { x: 30, y: 55 }, { x: 50, y: 55 }, { x: 70, y: 55 }, { x: 90, y: 55 }, { x: 35, y: 80 }, { x: 65, y: 80 }] },
            '5-3-2': { positions: ['goalkeeper', 'defender', 'defender', 'defender', 'defender', 'defender', 'midfielder', 'midfielder', 'midfielder', 'forward', 'forward'], slots: [{ x: 50, y: 10 }, { x: 15, y: 30 }, { x: 35, y: 30 }, { x: 50, y: 30 }, { x: 65, y: 30 }, { x: 85, y: 30 }, { x: 25, y: 60 }, { x: 50, y: 60 }, { x: 75, y: 60 }, { x: 35, y: 85 }, { x: 65, y: 85 }] }
        };

        let gameState = {
            currentTournament: null,
            currentClub: null,
            difficulty: 'easy',
            ratingType: 'tournament',
            selectedFormation: '4-4-2',
            team: [],
            rerolls: 3,
            showRatings: true,
            matchesWon: 0,
            matchHistory: [],
            currentPositionIndex: 0,
            selectedPlayer: null
        };

        // Initialize game
        function init() {
            renderTournaments();
            setupEventListeners();
        }

        function setupEventListeners() {
            // Difficulty buttons
            document.querySelectorAll('.diff-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('selected'));
                    this.classList.add('selected');
                    gameState.difficulty = this.dataset.diff;
                    if (gameState.difficulty === 'easy') gameState.rerolls = 3;
                    else if (gameState.difficulty === 'medium') gameState.rerolls = 1;
                    else gameState.rerolls = 0;
                    gameState.showRatings = gameState.difficulty !== 'hard';
                });
            });

            // Rating type buttons
            document.querySelectorAll('.rating-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.rating-btn').forEach(b => b.classList.remove('selected'));
                    this.classList.add('selected');
                    gameState.ratingType = this.dataset.rating;
                });
            });

            // Start game button
            document.getElementById('startGameBtn').addEventListener('click', showTournamentScreen);

            // Tournament selection
            document.getElementById('confirmTournamentBtn').addEventListener('click', startBuilder);

            // Formation buttons
            document.getElementById('formationOptions').addEventListener('click', e => {
                if (e.target.classList.contains('formation-btn')) {
                    document.querySelectorAll('.formation-btn').forEach(b => b.classList.remove('selected'));
                    e.target.classList.add('selected');
                    gameState.selectedFormation = e.target.dataset.formation;
                    renderPitch();
                }
            });

            // Roll club button
            document.getElementById('rollClubBtn').addEventListener('click', rollClub);
            document.getElementById('rerollBtn').addEventListener('click', rollClub);

            // Player selection
            document.getElementById('confirmPlayerBtn').addEventListener('click', confirmPlayer);

            // Next match button
            document.getElementById('nextMatchBtn').addEventListener('click', startNextMatch);

            // Play again button
            document.getElementById('playAgainBtn').addEventListener('click', () => {
                gameState = {
                    currentTournament: null,
                    currentClub: null,
                    difficulty: 'easy',
                    ratingType: 'tournament',
                    selectedFormation: '4-4-2',
                    team: [],
                    rerolls: 3,
                    showRatings: true,
                    matchesWon: 0,
                    matchHistory: [],
                    currentPositionIndex: 0,
                    selectedPlayer: null
                };
                showScreen('startScreen');
            });
        }

        function renderTournaments() {
            const grid = document.getElementById('tournamentGrid');
            grid.innerHTML = tournaments.map(t => `
                <div class="tournament-card" data-id="${t.id}">
                    <div class="tournament-badge">${t.badge}</div>
                    <div class="tournament-info">
                        <h4>${t.name}</h4>
                        <span>${t.years}</span>
                        <div style="margin-top: 8px; font-size: 0.8rem; color: var(--accent);">Famous: ${t.famous}</div>
                    </div>
                </div>
            `).join('');

            grid.querySelectorAll('.tournament-card').forEach(card => {
                card.addEventListener('click', function() {
                    grid.querySelectorAll('.tournament-card').forEach(c => c.classList.remove('selected'));
                    this.classList.add('selected');
                    gameState.currentTournament = this.dataset.id;
                    document.getElementById('confirmTournamentBtn').disabled = false;
                });
            });
        }

        function showScreen(screenId) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(screenId).classList.add('active');
            window.scrollTo(0, 0);
        }

        function showTournamentScreen() {
            showScreen('tournamentScreen');
        }

        function startBuilder() {
            gameState.team = [];
            gameState.currentPositionIndex = 0;
            gameState.matchesWon = 0;
            gameState.matchHistory = [];
            showScreen('builderScreen');
            renderFormations();
            renderPitch();
            updateTeamInfo();
        }

        function renderFormations() {
            const container = document.getElementById('formationOptions');
            container.innerHTML = Object.keys(formations).map(f => 
                `<button class="formation-btn ${f === '4-4-2' ? 'selected' : ''}" data-formation="${f}">${f}</button>`
            ).join('');
        }

        function renderPitch() {
            const pitch = document.getElementById('pitchContainer');
            const formation = formations[gameState.selectedFormation];
            
            // Clear existing slots
            pitch.querySelectorAll('.player-slot').forEach(s => s.remove());

            formation.slots.forEach((slot, index) => {
                const playerSlot = document.createElement('div');
                playerSlot.className = 'player-slot';
                if (index < gameState.team.length) playerSlot.classList.add('filled');
                if (index === gameState.currentPositionIndex) playerSlot.classList.add('current');

                const player = gameState.team[index];
                playerSlot.innerHTML = `
                    <div class="slot-circle">
                        ${player ? '✓' : ''}
                    </div>
                    <div class="slot-name">${player ? player.name : '?'}</div>
                    ${player && gameState.showRatings ? `<div class="slot-rating">${player.rating}</div>` : ''}
                    <div class="slot-position">${player ? player.position : formation.positions[index].substring(0, 3).toUpperCase()}</div>
                `;

                playerSlot.style.left = slot.x + '%';
                playerSlot.style.top = slot.y + '%';

                pitch.appendChild(playerSlot);
            });
        }

        function updateTeamInfo() {
            const formation = formations[gameState.selectedFormation];
            document.getElementById('currentPosition').textContent = formation.positions[gameState.currentPositionIndex] === 'goalkeeper' ? 'Goalkeeper' 
                : formation.positions[gameState.currentPositionIndex] === 'defender' ? 'Defender'
                : formation.positions[gameState.currentPositionIndex] === 'midfielder' ? 'Midfielder' : 'Forward';
            
            document.getElementById('positionCount').textContent = `Position ${gameState.currentPositionIndex + 1} of 11`;
            document.getElementById('rerollsLeft').textContent = gameState.rerolls;

            const avgRating = gameState.team.length > 0 
                ? Math.round(gameState.team.reduce((sum, p) => sum + p.rating, 0) / gameState.team.length)
                : 0;
            document.getElementById('teamRating').textContent = avgRating;
        }

        function rollClub() {
            const clubs = clubsDatabase[gameState.currentTournament];
            const badge = document.getElementById('clubBadge');
            badge.classList.add('rolling');
            
            setTimeout(() => {
                gameState.currentClub = clubs[Math.floor(Math.random() * clubs.length)];
                badge.textContent = gameState.currentClub.split(' ')[0];
                document.getElementById('clubName').textContent = gameState.currentClub;
                badge.classList.remove('rolling');
                
                showPlayerSelection();
            }, 1000);
        }

        function showPlayerSelection() {
            const formation = formations[gameState.selectedFormation];
            const positionType = formation.positions[gameState.currentPositionIndex];
            const players = playerDatabase[positionType];
            
            const grid = document.getElementById('playerGrid');
            grid.innerHTML = players.map(p => `
                <div class="player-card" data-name="${p.name}">
                    <div class="rating ${!gameState.showRatings ? 'hidden' : ''}">${gameState.showRatings ? p.rating : '?'}</div>
                    <div class="name">${p.name}</div>
                    <div class="position">${p.position}</div>
                </div>
            `).join('');

            grid.querySelectorAll('.player-card').forEach(card => {
                card.addEventListener('click', function() {
                    grid.querySelectorAll('.player-card').forEach(c => c.classList.remove('selected'));
                    this.classList.add('selected');
                    gameState.selectedPlayer = players.find(p => p.name === this.dataset.name);
                    document.getElementById('confirmPlayerBtn').disabled = false;
                });
            });

            document.getElementById('playerSelection').style.display = 'block';
            document.getElementById('rollSection').style.display = 'none';
            document.getElementById('rerollBtn').style.display = gameState.rerolls > 0 ? 'inline-block' : 'none';
        }

        function confirmPlayer() {
            if (gameState.selectedPlayer) {
                gameState.team.push(gameState.selectedPlayer);
                gameState.currentPositionIndex++;

                if (gameState.currentPositionIndex >= 11) {
                    startSimulation();
                } else {
                    document.getElementById('playerSelection').style.display = 'none';
                    document.getElementById('rollSection').style.display = 'block';
                    document.getElementById('rollClubBtn').textContent = '🎲 Roll Club';
                    document.getElementById('confirmPlayerBtn').disabled = true;
                    document.getElementById('clubName').textContent = 'Press Roll';
                    document.getElementById('clubBadge').textContent = '⚽';
                    updateTeamInfo();
                    renderPitch();
                }
            }
        }

        function startSimulation() {
            showScreen('simScreen');
            startNextMatch();
        }

        function startNextMatch() {
            if (gameState.matchesWon >= 6) {
                showResults();
            } else {
                const opponents = [
                    { name: 'Bayern Munich', strength: 85 },
                    { name: 'Barcelona', strength: 87 },
                    { name: 'AC Milan', strength: 83 },
                    { name: 'Liverpool', strength: 84 },
                    { name: 'Real Madrid', strength: 88 },
                    { name: 'Manchester United', strength: 82 }
                ];

                const opponent = opponents[Math.floor(Math.random() * opponents.length)];
                const userStrength = Math.round(gameState.team.reduce((s, p) => s + p.rating, 0) / gameState.team.length);
                const userWins = Math.random() * userStrength > Math.random() * opponent.strength;

                if (userWins) gameState.matchesWon++;
                gameState.matchHistory.push({ opponent: opponent.name, won: userWins });

                displayMatch(opponent, userWins);
            }
        }

        function displayMatch(opponent, won) {
            const userScore = won ? Math.floor(Math.random() * 3) + 1 : Math.floor(Math.random() * 2);
            const opponentScore = won ? Math.floor(Math.random() * 2) : Math.floor(Math.random() * 3) + 1;
            
            const matchCard = document.createElement('div');
            matchCard.className = 'match-card';
            matchCard.innerHTML = `
                <div class="match-header">Round ${gameState.matchHistory.length}</div>
                <div class="match-teams">
                    <div class="match-team user">
                        <div class="badge">⚽</div>
                        <div class="name">Your Team</div>
                    </div>
                    <div class="match-score">${userScore} - ${opponentScore}</div>
                    <div class="match-team">
                        <div class="badge">🏆</div>
                        <div class="name">${opponent.name}</div>
                    </div>
                </div>
                <div class="match-events">
                    <div class="event">
                        <span class="minute">45'</span>
                        <span class="icon">${won ? '⚽' : '🎯'}</span>
                        <span class="detail">Goal by</span>
                        <span class="player-name">${gameState.team[Math.floor(Math.random() * gameState.team.length)].name}</span>
                    </div>
                    <div class="event">
                        <span class="minute">60'</span>
                        <span class="icon">🟨</span>
                        <span class="detail">Yellow Card to</span>
                        <span class="player-name">${gameState.team[Math.floor(Math.random() * gameState.team.length)].name}</span>
                    </div>
                </div>
                <div class="commentary-box">
                    <p>${won ? "Brilliant performance! Your team dominated the match with excellent teamwork." : "Tough loss today. Better luck in the next match!"}</p>
                </div>
            `;

            document.getElementById('simContent').innerHTML = matchCard.innerHTML;
            document.getElementById('nextMatchBtn').style.display = 'block';
        }

        function showResults() {
            showScreen('resultsScreen');
            const trophy = gameState.matchesWon === 6 ? '🏆' : '🥈';
            const title = gameState.matchesWon === 6 ? 'CHAMPIONS! 👑' : 'Tournament Finished';
            
            let historyHtml = gameState.matchHistory.map((m, i) => `
                <div class="history-item">
                    <span class="round">Round ${i + 1} vs ${m.opponent}</span>
                    <span class="result ${m.won ? 'win' : 'loss'}">${m.won ? 'WIN' : 'LOSS'}</span>
                </div>
            `).join('');

            document.getElementById('resultsContent').innerHTML = `
                <div class="trophy-display">
                    <div class="trophy">${trophy}</div>
                    <div class="result-title ${gameState.matchesWon === 6 ? 'winner' : 'loser'}">${title}</div>
                    <div class="result-subtitle">You won ${gameState.matchesWon} out of 6 matches</div>
                    
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="label">Wins</div>
                            <div class="value">${gameState.matchesWon}</div>
                        </div>
                        <div class="stat-card">
                            <div class="label">Losses</div>
                            <div class="value">${6 - gameState.matchesWon}</div>
                        </div>
                        <div class="stat-card">
                            <div class="label">Avg Rating</div>
                            <div class="value">${Math.round(gameState.team.reduce((s, p) => s + p.rating, 0) / gameState.team.length)}</div>
                        </div>
                    </div>

                    <div class="match-history">
                        <h3>Match History</h3>
                        ${historyHtml}
                    </div>
                </div>
            `;
        }

        // Start the game
        init();
    </script>
</body>
</html>
