<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Champions of Europe | Dream Team Builder</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-dark: #0a0a0f;
            --bg-card: #12121a;
            --bg-hover: #1a1a25;
            --accent: #00ff88;
            --accent-dim: #00cc6a;
            --gold: #ffd700;
            --silver: #c0c0c0;
            --bronze: #cd7f32;
            --text-primary: #ffffff;
            --text-secondary: #8888aa;
            --danger: #ff4757;
            --warning: #ffa502;
        }

        body {
            font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg-dark);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Header */
        .header {
            text-align: center;
            padding: 40px 20px;
            position: relative;
        }

        .logo {
            font-size: 4rem;
            font-weight: 900;
            letter-spacing: -3px;
            background: linear-gradient(135deg, var(--accent) 0%, #00ccff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 60px rgba(0, 255, 136, 0.3);
        }

        .subtitle {
            color: var(--text-secondary);
            font-size: 1.1rem;
            margin-top: 10px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* Screens */
        .screen {
            display: none;
            animation: fadeIn 0.4s ease;
        }

        .screen.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Start Screen */
        .start-options {
            display: flex;
            flex-direction: column;
            gap: 30px;
            max-width: 600px;
            margin: 0 auto;
        }

        .option-group {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 25px;
            border: 1px solid #222;
        }

        .option-group h3 {
            color: var(--accent);
            margin-bottom: 15px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .difficulty-buttons, .rating-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .diff-btn, .rating-btn {
            flex: 1;
            min-width: 120px;
            padding: 20px 15px;
            border: 2px solid #333;
            background: var(--bg-dark);
            color: var(--text-primary);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .diff-btn:hover, .rating-btn:hover {
            border-color: var(--accent);
            background: var(--bg-hover);
        }

        .diff-btn.selected, .rating-btn.selected {
            border-color: var(--accent);
            background: rgba(0, 255, 136, 0.1);
        }

        .diff-btn .name, .rating-btn .name {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        .diff-btn .desc {
            font-size: 0.75rem;
            color: var(--text-secondary);
            line-height: 1.4;
        }

        .easy .name { color: #00ff88; }
        .medium .name { color: #ffa502; }
        .hard .name { color: #ff4757; }

        /* Tournament Selection */
        .tournament-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .tournament-card {
            background: var(--bg-card);
            border: 2px solid #222;
            border-radius: 16px;
            padding: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .tournament-card:hover {
            border-color: var(--accent);
            transform: translateY(-3px);
        }

        .tournament-card.selected {
            border-color: var(--accent);
            background: rgba(0, 255, 136, 0.05);
        }

        .tournament-badge {
            font-size: 2.5rem;
        }

        .tournament-info h4 {
            font-size: 1.1rem;
            margin-bottom: 5px;
        }

        .tournament-info span {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        /* Main Button */
        .main-btn {
            display: block;
            width: 100%;
            max-width: 400px;
            margin: 30px auto;
            padding: 20px 40px;
            font-size: 1.2rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--accent) 0%, #00ccff 100%);
            color: var(--bg-dark);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .main-btn:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 40px rgba(0, 255, 136, 0.3);
        }

        .main-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        /* Team Builder */
        .builder-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .position-info {
            text-align: center;
        }

        .position-info h2 {
            font-size: 1.5rem;
            color: var(--accent);
        }

        .position-info span {
            color: var(--text-secondary);
        }

        .team-rating {
            background: var(--bg-card);
            padding: 15px 25px;
            border-radius: 12px;
            text-align: center;
        }

        .team-rating .label {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
        }

        .team-rating .value {
            font-size: 2rem;
            font-weight: 900;
            color: var(--accent);
        }

        .rerolls-display {
            background: var(--bg-card);
            padding: 15px 25px;
            border-radius: 12px;
            text-align: center;
        }

        .rerolls-display .label {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
        }

        .rerolls-display .value {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--warning);
        }

        /* Formation Display */
        .formation-selector {
            margin-bottom: 30px;
        }

        .formation-selector h3 {
            margin-bottom: 15px;
            color: var(--text-secondary);
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .formation-options {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .formation-btn {
            padding: 10px 20px;
            border: 2px solid #333;
            background: var(--bg-dark);
            color: var(--text-primary);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 600;
        }

        .formation-btn:hover {
            border-color: var(--accent);
        }

        .formation-btn.selected {
            border-color: var(--accent);
            background: rgba(0, 255, 136, 0.1);
            color: var(--accent);
        }

        /* Pitch Display */
        .pitch-container {
            background: linear-gradient(to bottom, #1a4d1a 0%, #2d5a2d 50%, #1a4d1a 100%);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 30px;
            position: relative;
            aspect-ratio: 3/4;
            max-height: 500px;
            overflow: hidden;
        }

        .pitch-lines {
            position: absolute;
            inset: 20px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 8px;
        }

        .pitch-center-circle {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80px;
            height: 80px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
        }

        .pitch-center-line {
            position: absolute;
            top: 50%;
            left: 20px;
            right: 20px;
            height: 2px;
            background: rgba(255, 255, 255, 0.3);
        }

        .player-slot {
            position: absolute;
            width: 60px;
            height: 75px;
            transform: translate(-50%, -50%);
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .player-slot:hover {
            transform: translate(-50%, -50%) scale(1.1);
        }

        .player-slot.filled .slot-circle {
            background: linear-gradient(135deg, var(--accent) 0%, #00ccff 100%);
        }

        .player-slot.current .slot-circle {
            animation: pulse 1.5s infinite;
            box-shadow: 0 0 20px var(--accent);
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .slot-circle {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.5);
            margin: 0 auto 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .slot-name {
            font-size: 0.65rem;
            color: white;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 70px;
        }

        .slot-rating {
            font-size: 0.6rem;
            color: var(--accent);
            font-weight: 700;
        }

        .slot-position {
            font-size: 0.55rem;
            color: rgba(255, 255, 255, 0.7);
        }

        /* Club Roll */
        .roll-section {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 30px;
            text-align: center;
            margin-bottom: 20px;
        }

        .roll-section h3 {
            margin-bottom: 20px;
            color: var(--text-secondary);
        }

        .club-display {
            font-size: 4rem;
            margin-bottom: 10px;
            transition: transform 0.3s ease;
        }

        .club-display.rolling {
            animation: spin 0.1s linear infinite;
        }

        @keyframes spin {
            from { transform: rotateY(0deg); }
            to { transform: rotateY(360deg); }
        }

        .club-name {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .roll-btn {
            padding: 15px 40px;
            font-size: 1.1rem;
            font-weight: 700;
            border: none;
            border-radius: 10px;
            background: var(--accent);
            color: var(--bg-dark);
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 5px;
        }

        .roll-btn:hover {
            transform: scale(1.05);
        }

        .roll-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .roll-btn.secondary {
            background: var(--warning);
        }

        /* Player Selection */
        .player-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .player-card {
            background: var(--bg-card);
            border: 2px solid #333;
            border-radius: 12px;
            padding: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .player-card:hover {
            border-color: var(--accent);
            transform: translateY(-3px);
        }

        .player-card.selected {
            border-color: var(--accent);
            background: rgba(0, 255, 136, 0.1);
        }

        .player-card .rating {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--accent);
            margin-bottom: 5px;
        }

        .player-card .rating.hidden {
            color: var(--text-secondary);
        }

        .player-card .name {
            font-weight: 600;
            font-size: 0.95rem;
            margin-bottom: 3px;
        }

        .player-card .position {
            font-size: 0.75rem;
            color: var(--text-secondary);
        }

        .player-card .position-penalty {
            font-size: 0.7rem;
            color: var(--danger);
            margin-top: 5px;
        }

        /* Simulation Screen */
        .sim-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .match-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 20px;
            animation: slideIn 0.5s ease;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateX(-30px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .match-header {
            text-align: center;
            margin-bottom: 20px;
            color: var(--text-secondary);
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .match-teams {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .match-team {
            flex: 1;
            text-align: center;
        }

        .match-team .badge {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        .match-team .name {
            font-weight: 700;
            font-size: 1.1rem;
        }

        .match-team.user .name {
            color: var(--accent);
        }

        .match-score {
            font-size: 3rem;
            font-weight: 900;
            min-width: 120px;
            text-align: center;
        }

        .match-events {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #333;
        }

        .event {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 10px 0;
            font-size: 0.9rem;
            border-bottom: 1px solid #222;
        }

        .event:last-child {
            border-bottom: none;
        }

        .event .minute {
            color: var(--accent);
            font-weight: 700;
            min-width: 40px;
        }

        .event .icon {
            font-size: 1.2rem;
        }

        .event .detail {
            color: var(--text-secondary);
        }

        .event .player-name {
            color: var(--text-primary);
            font-weight: 600;
        }

        /* Commentary Box */
        .commentary-box {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            border-radius: 12px;
            padding: 20px;
            margin-top: 15px;
            border-left: 4px solid var(--accent);
        }

        .commentary-box p {
            font-style: italic;
            color: var(--text-secondary);
            line-height: 1.6;
        }

        /* Results Screen */
        .trophy-display {
            text-align: center;
            padding: 40px;
        }

        .trophy {
            font-size: 8rem;
            margin-bottom: 20px;
            animation: bounce 1s ease infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        .result-title {
            font-size: 2.5rem;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .result-title.winner {
            color: var(--gold);
        }

        .result-title.loser {
            color: var(--text-secondary);
        }

        .result-subtitle {
            color: var(--text-secondary);
            font-size: 1.2rem;
            margin-bottom: 30px;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
            margin: 30px 0;
        }

        .stat-card {
            background: var(--bg-card);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
        }

        .stat-card .label {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .stat-card .value {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--accent);
        }

        /* Match History */
        .match-history {
            margin-top: 30px;
        }

        .match-history h3 {
            margin-bottom: 20px;
            color: var(--text-secondary);
        }

        .history-item {
            background: var(--bg-card);
            border-radius: 12px;
            padding: 15px 20px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .history-item .round {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        .history-item .result {
            font-weight: 700;
        }

        .history-item .result.win {
            color: var(--accent);
        }

        .history-item .result.loss {
            color: var(--danger);
        }

        /* Loading spinner */
        .loading {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px;
        }

        .spinner {
            width: 60px;
            height: 60px;
            border: 4px solid #333;
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin-loader 1s linear infinite;
        }

        @keyframes spin-loader {
            to { transform: rotate(360deg); }
        }

        .loading p {
            margin-top: 20px;
            color: var(--text-secondary);
        }

        /* Responsive */
        @media (max-width: 600px) {
            .logo {
                font-size: 3rem;
            }
            
            .pitch-container {
                aspect-ratio: 2/3;
            }
            
            .player-slot {
                width: 50px;
                height: 65px;
            }
            
            .slot-circle {
                width: 35px;
                height: 35px;
                font-size: 0.75rem;
            }
            
            .slot-name {
                font-size: 0.55rem;
            }
            
            .match-score {
                font-size: 2rem;
                min-width: 80px;
            }
            
            .match-team .badge {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="header">
            <h1 class="logo">⭐ CHAMPIONS OF EUROPE ⭐</h1>
            <p class="subtitle">UEFA Champions League Dream Team</p>
        </header>

        <!-- Start Screen -->
        <div id="startScreen" class="screen active">
            <div class="start-options">
                <div class="option-group">
                    <h3>Select Difficulty</h3>
                    <div class="difficulty-buttons">
                        <button class="diff-btn easy selected" data-diff="easy">
                            <div class="name">Easy</div>
                            <div class="desc">3 Rerolls • See Ratings</div>
                        </button>
                        <button class="diff-btn medium" data-diff="medium">
                            <div class="name">Medium</div>
                            <div class="desc">1 Reroll • See Ratings</div>
                        </button>
                        <button class="diff-btn hard" data-diff="hard">
                            <div class="name">Hard</div>
                            <div class="desc">No Rerolls • Hidden Ratings</div>
                        </button>
                    </div>
                </div>

                <div class="option-group">
                    <h3>Player Ratings Based On</h3>
                    <div class="rating-buttons">
                        <button class="rating-btn selected" data-rating="tournament">
                            <div class="name">Competition Form</div>
                        </button>
                        <button class="rating-btn" data-rating="prime">
                            <div class="name">Prime Ratings</div>
                        </button>
                    </div>
                </div>

                <button class="main-btn" id="startGameBtn">Choose Tournament</button>
            </div>
        </div>

        <!-- Tournament Selection -->
        <div id="tournamentScreen" class="screen">
            <h2 style="text-align: center; margin-bottom: 30px;">Select Your European Cup Era</h2>
            <div class="tournament-grid" id="tournamentGrid"></div>
            <button class="main-btn" id="confirmTournamentBtn" disabled>Build Your Team</button>
        </div>

        <!-- Team Builder -->
        <div id="builderScreen" class="screen">
            <div class="builder-header">
                <div class="rerolls-display">
                    <div class="label">Rerolls Left</div>
                    <div class="value" id="rerollsLeft">3</div>
                </div>
                <div class="position-info">
                    <h2 id="currentPosition">Goalkeeper</h2>
                    <span id="positionCount">Position 1 of 11</span>
                </div>
                <div class="team-rating">
                    <div class="label">Team Rating</div>
                    <div class="value" id="teamRating">0</div>
                </div>
            </div>

            <div class="formation-selector">
                <h3>Formation</h3>
                <div class="formation-options" id="formationOptions"></div>
            </div>

            <div class="pitch-container" id="pitchContainer">
                <div class="pitch-lines"></div>
                <div class="pitch-center-circle"></div>
                <div class="pitch-center-line"></div>
            </div>

            <div class="roll-section" id="rollSection">
                <h3>Roll for Club</h3>
                <div class="club-display" id="clubBadge">⚽</div>
                <div class="club-name" id="clubName">Press Roll</div>
                <button class="roll-btn" id="rollClubBtn">🎲 Roll Club</button>
                <button class="roll-btn secondary" id="rerollBtn" style="display: none;">🔄 Reroll</button>
            </div>

            <div id="playerSelection" style="display: none;">
                <h3 style="margin-bottom: 15px;">Select a Player</h3>
                <div class="player-grid" id="playerGrid"></div>
                <button class="main-btn" id="confirmPlayerBtn" disabled>Confirm Selection</button>
            </div>
        </div>

        <!-- Simulation Screen -->
        <div id="simScreen" class="screen">
            <div class="sim-container">
                <div id="simContent"></div>
                <button class="main-btn" id="nextMatchBtn" style="display: none;">Next Match</button>
            </div>
        </div>

        <!-- Results Screen -->
        <div id="resultsScreen" class="screen">
            <div id="resultsContent"></div>
            <button class="main-btn" id="playAgainBtn">Play Again</button>
        </div>
    </div>

    <script>
        // Game data for Champions League eras
        const tournaments = [
            { id: 'european-cup-60s', name: 'European Cup Era (1960s)', badge: '🏆', years: '1960-1969', famous: 'Real Madrid' },
            { id: 'european-cup-70s', name: 'European Cup Era (1970s)', badge: '🏆', years: '1970-1979', famous: 'Bayern Munich' },
            { id: 'european-cup-80s', name: 'European Cup Era (1980s)', badge: '🏆', years: '1980-1989', famous: 'AC Milan' },
            { id: 'champions-league-90s', name: 'Champions League (1990s)', badge: '⭐', years: '1992-1999', famous: 'Manchester United' },
            { id: 'champions-league-2000s', name: 'Champions League (2000s)', badge: '⭐', years: '2000-2009', famous: 'AC Milan' },
            { id: 'champions-league-2010s', name: 'Champions League (2010s)', badge: '⭐', years: '2010-2019', famous: 'Barcelona' },
            { id: 'champions-league-2020s', name: 'Champions League (2020s)', badge: '⭐', years: '2020-2024', famous: 'Real Madrid' }
        ];

        const clubsDatabase = {
            'european-cup-60s': ['🇪🇸 Real Madrid', '🇮🇹 AC Milan', '🇬🇪 Eintracht Frankfurt', '🇵🇹 Benfica', '🇪🇸 Barcelona'],
            'european-cup-70s': ['🇩🇪 Bayern Munich', '🇮🇹 AC Milan', '🇮🇹 Inter Milan', '🇫🇷 Saint-Étienne', '🇳🇱 Ajax'],
            'european-cup-80s': ['🇮🇹 AC Milan', '🇩🇪 Hamburg', '🇳🇱 PSV Eindhoven', '🇬🇧 Nottingham Forest', '🇪🇸 Real Madrid'],
            'champions-league-90s': ['🇬🇧 Manchester United', '🇩🇪 Bayern Munich', '🇮🇹 AC Milan', '🇫🇷 Olympique Marseille', '🇪🇸 Real Madrid'],
            'champions-league-2000s': ['🇮🇹 AC Milan', '🇪🇸 Real Madrid', '🇮🇹 Inter Milan', '🇩🇪 Bayern Munich', '🇮🇹 Roma'],
            'champions-league-2010s': ['🇪🇸 Barcelona', '🇬🇧 Manchester United', '🇩🇪 Bayern Munich', '🇮🇹 AC Milan', '🇪🇸 Real Madrid'],
            'champions-league-2020s': ['🇪🇸 Real Madrid', '🇫🇷 Paris Saint-Germain', '🇬🇧 Manchester City', '🇬🇧 Liverpool', '🇩🇪 Bayern Munich']
        };

        // Player database with positions
        const playerDatabase = {
            'goalkeeper': [
                { name: 'Buffon', rating: 95, position: 'GK' },
                { name: 'Neuer', rating: 96, position: 'GK' },
                { name: 'van der Sar', rating: 93, position: 'GK' },
                { name: 'Casillas', rating: 92, position: 'GK' },
                { name: 'Yashin', rating: 91, position: 'GK' },
                { name: 'De Sanctis', rating: 84, position: 'GK' },
                { name: 'Reina', rating: 85, position: 'GK' },
                { name: 'Handanovic', rating: 83, position: 'GK' }
            ],
            'defender': [
                { name: 'Maldini', rating: 97, position: 'DEF' },
                { name: 'Ramos', rating: 96, position: 'DEF' },
                { name: 'Beckenbauer', rating: 97, position: 'DEF' },
                { name: 'Baresi', rating: 95, position: 'DEF' },
                { name: 'Cannavaro', rating: 93, position: 'DEF' },
                { name: 'Nesta', rating: 91, position: 'DEF' },
                { name: 'van Dijk', rating: 94, position: 'DEF' },
                { name: 'Carvalho', rating: 90, position: 'DEF' }
            ],
            'midfielder': [
                { name: 'Zidane', rating: 98, position: 'MID' },
                { name: 'Iniesta', rating: 97, position: 'MID' },
                { name: 'Gerrard', rating: 94, position: 'MID' },
                { name: 'Scholes', rating: 92, position: 'MID' },
                { name: 'Pirlo', rating: 96, position: 'MID' },
                { name: 'Xavi', rating: 97, position: 'MID' },
                { name: 'Seedorf', rating: 93, position: 'MID' },
                { name: 'Totti', rating: 94, position: 'MID' }
            ],
            'forward': [
                { name: 'Messi', rating: 99, position: 'FWD' },
                { name: 'Ronaldo', rating: 99, position: 'FWD' },
                { name: 'Maradona', rating: 98, position: 'FWD' },
                { name: 'Ronaldinho', rating: 97, position: 'FWD' },
                { name: 'Cristiano', rating: 98, position: 'FWD' },
                { name: 'Platini', rating: 94, position: 'FWD' },
                { name: 'Van Basten', rating: 96, position: 'FWD' },
                { name: 'Gerd Müller', rating: 95, position: 'FWD' }
            ]
        };

        let gameState = {
            currentTournament: null,
            currentClub: null,
            difficulty: 'easy',
            ratingBasis: 'tournament',
            rerollsLeft: 3,
            team: [],
            selectedPlayer: null,
            formation: '4-3-3',
            showRatings: true
        };

        // DOM Elements
        const startBtn = document.getElementById('startGameBtn');
        const tournamentGrid = document.getElementById('tournamentGrid');
        const confirmTournamentBtn = document.getElementById('confirmTournamentBtn');
        const rollClubBtn = document.getElementById('rollClubBtn');
        const rerollBtn = document.getElementById('rerollBtn');
        const confirmPlayerBtn = document.getElementById('confirmPlayerBtn');
        const playAgainBtn = document.getElementById('playAgainBtn');

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            setupEventListeners();
        });

        function setupEventListeners() {
            startBtn.addEventListener('click', startGame);
            confirmTournamentBtn.addEventListener('click', goToBuilder);
            rollClubBtn.addEventListener('click', rollClub);
            rerollBtn.addEventListener('click', rerollClub);
            confirmPlayerBtn.addEventListener('click', confirmPlayer);
            playAgainBtn.addEventListener('click', resetGame);

            // Difficulty buttons
            document.querySelectorAll('.diff-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('selected'));
                    this.classList.add('selected');
                    gameState.difficulty = this.dataset.diff;
                    gameState.rerollsLeft = this.dataset.diff === 'easy' ? 3 : this.dataset.diff === 'medium' ? 1 : 0;
                    gameState.showRatings = this.dataset.diff !== 'hard';
                });
            });

            // Rating buttons
            document.querySelectorAll('.rating-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.rating-btn').forEach(b => b.classList.remove('selected'));
                    this.classList.add('selected');
                    gameState.ratingBasis = this.dataset.rating;
                });
            });

            // Formation buttons
            setupFormations();
        }

        function startGame() {
            showScreen('tournamentScreen');
            renderTournaments();
        }

        function renderTournaments() {
            tournamentGrid.innerHTML = '';
            tournaments.forEach(tournament => {
                const card = document.createElement('div');
                card.className = 'tournament-card';
                if (gameState.currentTournament === tournament.id) {
                    card.classList.add('selected');
                }
                card.innerHTML = `
                    <div class="tournament-badge">${tournament.badge}</div>
                    <div class="tournament-info">
                        <h4>${tournament.name}</h4>
                        <span>${tournament.years}</span>
                        <span>Famous: ${tournament.famous}</span>
                    </div>
                `;
                card.addEventListener('click', () => {
                    gameState.currentTournament = tournament.id;
                    renderTournaments();
                    confirmTournamentBtn.disabled = false;
                });
                tournamentGrid.appendChild(card);
            });
        }

        function goToBuilder() {
            showScreen('builderScreen');
            setupFormations();
            gameState.team = [];
            updateTeamRating();
            rollClub();
        }

        function setupFormations() {
            const formationContainer = document.getElementById('formationOptions');
            formationContainer.innerHTML = '';
            const formations = ['4-3-3', '3-4-3', '4-4-2', '5-3-2'];
            formations.forEach(formation => {
                const btn = document.createElement('button');
                btn.className = `formation-btn ${formation === gameState.formation ? 'selected' : ''}`;
                btn.textContent = formation;
                btn.addEventListener('click', () => {
                    gameState.formation = formation;
                    document.querySelectorAll('.formation-btn').forEach(b => b.classList.remove('selected'));
                    btn.classList.add('selected');
                });
                formationContainer.appendChild(btn);
            });
        }

        function rollClub() {
            const clubs = clubsDatabase[gameState.currentTournament];
            const randomClub = clubs[Math.floor(Math.random() * clubs.length)];
            gameState.currentClub = randomClub;
            document.getElementById('clubBadge').textContent = randomClub.split(' ')[0];
            document.getElementById('clubName').textContent = randomClub;
            
            if (gameState.rerollsLeft > 0) {
                rerollBtn.style.display = 'inline-block';
            } else {
                rerollBtn.style.display = 'none';
            }
            
            showPlayerSelection();
        }

        function rerollClub() {
            if (gameState.rerollsLeft > 0) {
                gameState.rerollsLeft--;
                document.getElementById('rerollsLeft').textContent = gameState.rerollsLeft;
                rollClub();
            }
        }

        function showPlayerSelection() {
            const positionIndex = gameState.team.length;
            const positions = ['goalkeeper', 'defender', 'defender', 'defender', 'midfielder', 'midfielder', 'midfielder', 'forward', 'forward', 'forward', 'forward'];
            
            if (positionIndex >= 11) {
                startSimulation();
                return;
            }

            const currentPosition = positions[positionIndex];
            document.getElementById('currentPosition').textContent = currentPosition.charAt(0).toUpperCase() + currentPosition.slice(1);
            document.getElementById('positionCount').textContent = `Position ${positionIndex + 1} of 11`;

            const playerGrid = document.getElementById('playerGrid');
            playerGrid.innerHTML = '';

            const availablePlayers = playerDatabase[currentPosition];
            availablePlayers.forEach(player => {
                const card = document.createElement('div');
                card.className = 'player-card';
                const displayRating = gameState.showRatings ? player.rating : '?';
                card.innerHTML = `
                    <div class="rating ${!gameState.showRatings ? 'hidden' : ''}">${displayRating}</div>
                    <div class="name">${player.name}</div>
                    <div class="position">${player.position}</div>
                `;
                card.addEventListener('click', () => {
                    gameState.selectedPlayer = player;
                    document.querySelectorAll('.player-card').forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    confirmPlayerBtn.disabled = false;
                });
                playerGrid.appendChild(card);
            });

            document.getElementById('playerSelection').style.display = 'block';
            document.getElementById('rollSection').style.display = 'none';
            confirmPlayerBtn.disabled = true;
        }

        function confirmPlayer() {
            if (gameState.selectedPlayer) {
                gameState.team.push({...gameState.selectedPlayer, club: gameState.currentClub});
                updateTeamRating();
                gameState.selectedPlayer = null;
                document.getElementById('playerSelection').style.display = 'none';
                document.getElementById('rollSection').style.display = 'block';
                rollClub();
            }
        }

        function updateTeamRating() {
            const avgRating = gameState.team.length > 0 
                ? Math.round(gameState.team.reduce((sum, p) => sum + p.rating, 0) / gameState.team.length)
                : 0;
            document.getElementById('teamRating').textContent = avgRating;
        }

        function startSimulation() {
            showScreen('simScreen');
            runSimulation();
        }

        function runSimulation() {
            const simContent = document.getElementById('simContent');
            simContent.innerHTML = '';

            // Simulate multiple matches
            const matches = generateMatches(3);
            matches.forEach((match, index) => {
                const matchCard = document.createElement('div');
                matchCard.className = 'match-card';
                
                const userScore = generateScore();
                const opponentScore = generateScore();
                const isWin = userScore > opponentScore;

                matchCard.innerHTML = `
                    <div class="match-header">Round ${index + 1} - ${match.round}</div>
                    <div class="match-teams">
                        <div class="match-team user">
                            <div class="badge">⭐</div>
                            <div class="name">Your Team</div>
                        </div>
                        <div class="match-score">${userScore} - ${opponentScore}</div>
                        <div class="match-team">
                            <div class="badge">${match.badge}</div>
                            <div class="name">${match.team}</div>
                        </div>
                    </div>
                    <div class="match-events">
                        ${generateMatchEvents(userScore, opponentScore).map(event => `
                            <div class="event">
                                <span class="minute">${event.minute}'</span>
                                <span class="icon">${event.icon}</span>
                                <span class="detail">${event.detail}</span>
                                <span class="player-name">${event.player}</span>
                            </div>
                        `).join('')}
                    </div>
                    <div class="commentary-box">
                        <p>"${generateCommentary(isWin, userScore, opponentScore)}"</p>
                    </div>
                `;
                
                simContent.appendChild(matchCard);
            });

            // Show final results
            const finalWins = Math.floor(Math.random() * 2) + 1;
            setTimeout(() => {
                if (finalWins >= 2) {
                    showWinScreen();
                } else {
                    showLossScreen();
                }
            }, 500);
        }

        function generateMatches(count) {
            const rounds = ['Group Stage', 'Round of 16', 'Quarter-Finals', 'Semi-Finals', 'Finals'];
            const opponents = [
                { team: 'Barcelona', badge: '🔵🔴', region: 'Spain' },
                { team: 'Bayern Munich', badge: '🔴⚪', region: 'Germany' },
                { team: 'AC Milan', badge: '🔴⚫', region: 'Italy' },
                { team: 'Manchester United', badge: '🔴', region: 'England' },
                { team: 'Liverpool', badge: '🔴', region: 'England' }
            ];

            const matches = [];
            for (let i = 0; i < count; i++) {
                const opponent = opponents[Math.floor(Math.random() * opponents.length)];
                matches.push({
                    round: rounds[i],
                    team: opponent.team,
                    badge: opponent.badge
                });
            }
            return matches;
        }

        function generateScore() {
            return Math.floor(Math.random() * 5);
        }

        function generateMatchEvents(userScore, opponentScore) {
            const events = [];
            const playerNames = gameState.team.map(p => p.name);

            for (let i = 0; i < userScore; i++) {
                events.push({
                    minute: Math.floor(Math.random() * 85) + 5,
                    icon: '⚽',
                    detail: 'GOAL',
                    player: playerNames[Math.floor(Math.random() * playerNames.length)]
                });
            }

            return events.sort((a, b) => a.minute - b.minute);
        }

        function generateCommentary(isWin, userScore, opponentScore) {
            const commentaries = {
                win: [
                    `Absolute dominance! ${userScore} goals showcase your team's quality.`,
                    `What a performance! Your dream team delivered under pressure.`,
                    `Clinical finishing and stellar defense. Onwards to glory!`
                ],
                loss: [
                    `Close match, but it wasn't meant to be. Better luck next time!`,
                    `The opposition was just too strong. You gave it your all.`,
                    `Tough loss, but this team has the quality to bounce back.`
                ]
            };

            const pool = isWin ? commentaries.win : commentaries.loss;
            return pool[Math.floor(Math.random() * pool.length)];
        }

        function showWinScreen() {
            showScreen('resultsScreen');
            const resultsContent = document.getElementById('resultsContent');
            resultsContent.innerHTML = `
                <div class="trophy-display">
                    <div class="trophy">🏆</div>
                    <h2 class="result-title winner">CHAMPIONS OF EUROPE!</h2>
                    <p class="result-subtitle">Your dream team conquered Europe!</p>
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="label">Avg Team Rating</div>
                            <div class="value">${Math.round(gameState.team.reduce((sum, p) => sum + p.rating, 0) / gameState.team.length)}</div>
                        </div>
                        <div class="stat-card">
                            <div class="label">Players Selected</div>
                            <div class="value">${gameState.team.length}</div>
                        </div>
                        <div class="stat-card">
                            <div class="label">Formation</div>
                            <div class="value">${gameState.formation}</div>
                        </div>
                    </div>
                </div>
            `;
        }

        function showLossScreen() {
            showScreen('resultsScreen');
            const resultsContent = document.getElementById('resultsContent');
            resultsContent.innerHTML = `
                <div class="trophy-display">
                    <div class="trophy">🥈</div>
                    <h2 class="result-title loser">Campaign Ended</h2>
                    <p class="result-subtitle">A respectable showing from your dream team</p>
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="label">Avg Team Rating</div>
                            <div class="value">${Math.round(gameState.team.reduce((sum, p) => sum + p.rating, 0) / gameState.team.length)}</div>
                        </div>
                        <div class="stat-card">
                            <div class="label">Players Selected</div>
                            <div class="value">${gameState.team.length}</div>
                        </div>
                        <div class="stat-card">
                            <div class="label">Formation</div>
                            <div class="value">${gameState.formation}</div>
                        </div>
                    </div>
                </div>
            `;
        }

        function resetGame() {
            gameState = {
                currentTournament: null,
                currentClub: null,
                difficulty: 'easy',
                ratingBasis: 'tournament',
                rerollsLeft: 3,
                team: [],
                selectedPlayer: null,
                formation: '4-3-3',
                showRatings: true
            };
            showScreen('startScreen');
            document.getElementById('rerollsLeft').textContent = '3';
        }

        function showScreen(screenId) {
            document.querySelectorAll('.screen').forEach(screen => {
                screen.classList.remove('active');
            });
            document.getElementById(screenId).classList.add('active');
        }
    </script>
</body>
</html>
