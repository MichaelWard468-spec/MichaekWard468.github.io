        function renderPitch() {
            const container = document.getElementById('pitchContainer');
            // Clear existing slots
            container.querySelectorAll('.player-slot').forEach(s => s.remove());

            const formation = gameState.formation;
            const positions = FORMATIONS[formation].positions;
            const coords = POSITION_COORDINATES[formation];

            positions.forEach((pos, index) => {
                // Handle duplicate positions (CB_1, CB_2, etc.)
                let coordKey = pos;
                let count = 1;
                for (let i = 0; i < index; i++) {
                    if (positions[i] === pos) count++;
                }
                if (count > 1) coordKey = `${pos}_${count}`;
                
                const coord = coords[coordKey] || coords[pos] || { x: 50, y: 50 };
                const positionId = count > 1 ? `${pos}_${count}` : pos;
                
                const teamPlayer = gameState.team.find(t => t.position === positionId);
                const isCurrent = index === gameState.currentPositionIndex;
                
                const slot = document.createElement('div');
                slot.className = `player-slot ${teamPlayer ? 'filled' : ''} ${isCurrent ? 'current' : ''}`;
                slot.style.left = `${coord.x}%`;
                slot.style.top = `${coord.y}%`;
                slot.innerHTML = `
                    <div class="slot-circle">${teamPlayer ? teamPlayer.player.rating : (index + 1)}</div>
                    <div class="slot-name">${teamPlayer ? teamPlayer.player.name : ''}</div>
                    <div class="slot-position">${pos}</div>
                `;
                container.appendChild(slot);
            });
        }

        function updateBuilderUI() {
            const positions = FORMATIONS[gameState.formation].positions;
            const currentPos = positions[gameState.currentPositionIndex];
            const basePos = currentPos ? currentPos.replace(/_\d+$/, '') : '';
            
            document.getElementById('currentPosition').textContent = POSITION_NAMES[basePos] || currentPos;
            document.getElementById('positionCount').textContent = `Position ${gameState.currentPositionIndex + 1} of 11`;
