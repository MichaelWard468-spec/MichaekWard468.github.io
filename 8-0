            knockoutRound: null
        };

        // ============ DOM ELEMENTS ============
        const screens = {
            start: document.getElementById('startScreen'),
            tournament: document.getElementById('tournamentScreen'),
            builder: document.getElementById('builderScreen'),
            sim: document.getElementById('simScreen'),
            results: document.getElementById('resultsScreen')
        };

        // ============ UTILITY FUNCTIONS ============
        function showScreen(screenId) {
            Object.values(screens).forEach(s => s.classList.remove('active'));
            screens[screenId].classList.add('active');
        }

        function getRandomElement(arr) {
            return arr[Math.floor(Math.random() * arr.length)];
        }

        function generatePlayer(position, country, tournamentId) {
            const posGroup = Object.entries(POSITION_GROUPS).find(([_, positions]) => 
                positions.includes(position.replace(/_\d+$/, ''))
            )?.[0] || 'MID';
            
            const basePosition = position.replace(/_\d+$/, '');
            const names = FAMOUS_PLAYERS[posGroup] || FAMOUS_PLAYERS.MID;
            
            // Generate 4 players for selection
            const players = [];
            const usedNames = new Set();
            
            for (let i = 0; i < 4; i++) {
                let name;
                do {
                    name = getRandomElement(names);
                } while (usedNames.has(name) && usedNames.size < names.length);
                usedNames.add(name);
                
                const baseRating = country.rating + Math.floor(Math.random() * 10) - 5;
                const rating = Math.min(99, Math.max(60, baseRating + (gameState.ratingMode === 'prime' ? 5 : 0)));
                
                // Random natural positions for the player
                const naturalPositions = [basePosition];
                if (Math.random() > 0.5) {
                    const samePosGroup = POSITION_GROUPS[posGroup];
                    naturalPositions.push(getRandomElement(samePosGroup.filter(p => p !== basePosition)));
                }
                
                players.push({
                    name,
                    rating,
                    position: basePosition,
                    naturalPositions,
                    country: country.name,
                    countryFlag: country.flag,
                    goals: 0,
                    assists: 0,
                    matchRating: 0,
                    matchesPlayed: 0
                });
            }
            
            return players;
        }

        function calculatePositionPenalty(player, requiredPosition) {
            const basePos = requiredPosition.replace(/_\d+$/, '');
            if (player.naturalPositions.includes(basePos)) {
                return 0;
            }
            
            // Find which group the player's position is in vs required
            const playerGroup = Object.entries(POSITION_GROUPS).find(([_, positions]) => 
                positions.includes(player.position)
            )?.[0];
            const requiredGroup = Object.entries(POSITION_GROUPS).find(([_, positions]) => 
                positions.includes(basePos)
            )?.[0];
            
            if (playerGroup === requiredGroup) return -3;
            if ((playerGroup === 'DEF' && requiredGroup === 'MID') || 
                (playerGroup === 'MID' && requiredGroup === 'DEF') ||
                (playerGroup === 'MID' && requiredGroup === 'ATT') ||
                (playerGroup === 'ATT' && requiredGroup === 'MID')) return -5;
            
            return -8; // GK playing outfield or vice versa
        }

        function calculateTeamRating() {
            if (gameState.team.length === 0) return 0;
            
            let total = 0;
            gameState.team.forEach(p => {
                const penalty = calculatePositionPenalty(p.player, p.position);
                total += p.player.rating + penalty;
            });
            
            return Math.round(total / gameState.team.length);
        }

        // ============ UI FUNCTIONS ============
        function initStartScreen() {
