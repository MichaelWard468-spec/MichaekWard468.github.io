        function rollCountry() {
            const rollSection = document.getElementById('rollSection');
            const flagDisplay = document.getElementById('countryFlag');
            const nameDisplay = document.getElementById('countryName');
            const rollBtn = document.getElementById('rollCountryBtn');
            const rerollBtn = document.getElementById('rerollBtn');
            
            flagDisplay.classList.add('rolling');
            rollBtn.disabled = true;
            
            const countries = COUNTRIES[gameState.tournament.id];
            let iterations = 0;
            const maxIterations = 20;
            
            const interval = setInterval(() => {
                const randomCountry = getRandomElement(countries);
                flagDisplay.textContent = randomCountry.flag;
                nameDisplay.textContent = randomCountry.name;
                iterations++;
                
                if (iterations >= maxIterations) {
                    clearInterval(interval);
                    flagDisplay.classList.remove('rolling');
                    
                    // Final selection
                    gameState.rolledCountry = getRandomElement(countries);
                    flagDisplay.textContent = gameState.rolledCountry.flag;
                    nameDisplay.textContent = gameState.rolledCountry.name;
                    
                    rollBtn.style.display = 'none';
                    if (gameState.rerollsLeft > 0) {
                        rerollBtn.style.display = 'inline-block';
                    }
                    
                    showPlayerSelection();
                }
            }, 80);
        }

        function rerollCountry() {
            if (gameState.rerollsLeft <= 0) return;
            
            gameState.rerollsLeft--;
            updateBuilderUI();
            
            const flagDisplay = document.getElementById('countryFlag');
            const nameDisplay = document.getElementById('countryName');
            const rerollBtn = document.getElementById('rerollBtn');
            
            flagDisplay.classList.add('rolling');
            
            const countries = COUNTRIES[gameState.tournament.id];
            let iterations = 0;
            const maxIterations = 15;
            
            const interval = setInterval(() => {
                const randomCountry = getRandomElement(countries);
                flagDisplay.textContent = randomCountry.flag;
                nameDisplay.textContent = randomCountry.name;
                iterations++;
                
                if (iterations >= maxIterations) {
                    clearInterval(interval);
                    flagDisplay.classList.remove('rolling');
                    
                    gameState.rolledCountry = getRandomElement(countries);
                    flagDisplay.textContent = gameState.rolledCountry.flag;
                    nameDisplay.textContent = gameState.rolledCountry.name;
                    
                    if (gameState.rerollsLeft <= 0) {
                        rerollBtn.style.display = 'none';
                    }
                    
                    showPlayerSelection();
                }
            }, 80);
        }

        function showPlayerSelection() {
            const container = document.getElementById('playerSelection');
            const grid = document.getElementById('playerGrid');
            
            const positions = FORMATIONS[gameState.formation].positions;
            let currentPos = positions[gameState.currentPositionIndex];
            
            // Handle duplicate positions
            let count = 1;
            for (let i = 0; i < gameState.currentPositionIndex; i++) {
                if (positions[i] === currentPos) count++;
            }
            const positionId = count > 1 ? `${currentPos}_${count}` : currentPos;
            
            const players = generatePlayer(positionId, gameState.rolledCountry, gameState.tournament.id);
            
            grid.innerHTML = players.map((p, i) => {
                const penalty = calculatePositionPenalty(p, positionId);
                const showRating = gameState.difficulty !== 'hard';
                
                return `
                    <div class="player-card" data-index="${i}">
                        <div class="rating ${showRating ? '' : 'hidden'}">
                            ${showRating ? p.rating : '??'}
                        </div>
                        <div class="name">${p.name}</div>
                        <div class="position">${p.position} • ${p.countryFlag}</div>
