        function showGroupStandings() {
            const { groups, userGroup } = gameState.groupStage;
            const group = groups[userGroup];
            
            // Simulate other matches in the group
            for (let i = 0; i < group.length; i++) {
                for (let j = i + 1; j < group.length; j++) {
                    if (group[i].isUser || group[j].isUser) continue;
                    
                    const result = simulateMatch(group[i], group[j], 'group');
                    if (result.score1 > result.score2) {
                        group[i].points += 3;
                    } else if (result.score1 < result.score2) {
                        group[j].points += 3;
                    } else {
                        group[i].points += 1;
                        group[j].points += 1;
                    }
                    group[i].gf += result.score1;
                    group[i].ga += result.score2;
                    group[i].gd += (result.score1 - result.score2);
                    group[j].gf += result.score2;
                    group[j].ga += result.score1;
                    group[j].gd += (result.score2 - result.score1);
                }
            }
            
            // Sort group
            group.sort((a, b) => b.points - a.points || b.gd - a.gd || b.gf - a.gf);
            
            const userTeam = group.find(t => t.isUser);
            const userPosition = group.indexOf(userTeam);
            const qualified = userPosition < 2;
            
            const container = document.getElementById('simContent');
            container.innerHTML = `
                <div class="match-card">
                    <div class="match-header">GROUP ${userGroup} - FINAL STANDINGS</div>
                    
                    <table class="group-table">
                        <thead>
                            <tr>
                                <th>Team</th>
                                <th>P</th>
                                <th>GD</th>
                                <th>Pts</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${group.map((team, i) => `
                                <tr class="${i < 2 ? 'qualified' : ''} ${team.isUser ? 'user-team' : ''}">
                                    <td>
                                        <div class="team-row">
                                            <span>${team.flag}</span>
                                            <span>${team.name}</span>
                                        </div>
                                    </td>
                                    <td>3</td>
                                    <td>${team.gd > 0 ? '+' : ''}${team.gd}</td>
                                    <td>${team.points}</td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                    
                    <div class="commentary-box">
                        <p>${qualified ? 
                            '"Your Dream Team advances to the knockout rounds! The real competition begins now!"' :
                            '"Crashed out in the group stages. Not the World Cup dream you were hoping for..."'
                        }</p>
                    </div>
                </div>
            `;
            
            const btn = document.getElementById('nextMatchBtn');
            btn.style.display = 'block';
            btn.textContent = qualified ? 'Round of 16' : 'See Results';
            btn.onclick = () => {
                btn.style.display = 'none';
                if (qualified) {
                    startKnockout(userTeam, 'R16');
                } else {
                    gameState.eliminated = true;
                    showResults();
                }
            };
        }

        function startKnockout(userTeam, round) {
            // Get a random opponent based on round
            const countries = COUNTRIES[gameState.tournament.id];
            const ratingRange = {
                'R16': [75, 85],
                'QF': [80, 88],
                'SF': [83, 90],
                'F': [85, 92]
            }[round];
            
            const possibleOpponents = countries.filter(c => 
                c.rating >= ratingRange[0] && c.rating <= ratingRange[1]
            );
            
            const opponent = getRandomElement(possibleOpponents);
            const result = simulateMatch(userTeam, opponent, round);
            
            gameState.matches.push(result);
            
            const roundNames = {
                'R16': 'ROUND OF 16',
                'QF': 'QUARTER-FINAL',
                'SF': 'SEMI-FINAL',
                'F': 'FINAL'
            };
            
            const userWon = result.team1.isUser ? result.score1 > result.score2 : result.score2 > result.score1;
            
            displayMatch(result, roundNames[round], () => {
                if (!userWon) {
                    gameState.eliminated = true;
                    gameState.knockoutRound = round;
                    showResults();
                } else if (round === 'F') {
                    gameState.knockoutRound = 'CHAMPION';
                    showResults();
                } else {
                    const nextRound = {
                        'R16': 'QF',
                        'QF': 'SF',
                        'SF': 'F'
                    }[round];
                    startKnockout(userTeam, nextRound);
                }
            });
        }

        function showResults() {
            showScreen('results');
            
            const isChampion = gameState.knockoutRound === 'CHAMPION';
            const roundReached = gameState.knockoutRound || 'GROUP';
            
            const container = document.getElementById('resultsContent');
            
            // Calculate total stats
            const totalGoals = gameState.matches.reduce((sum, m) => sum + m.userGoals, 0);
            const totalConceded = gameState.matches.reduce((sum, m) => sum + m.opponentGoals, 0);
            const wins = gameState.matches.filter(m => m.userWin).length;
            const draws = gameState.matches.filter(m => m.draw).length;
            const losses = gameState.matches.length - wins - draws;
            
            // Sort players by goals
            const playerStats = gameState.team.map(t => ({
                ...t.player,
                position: t.position,
                effectiveRating: t.player.rating + calculatePositionPenalty(t.player, t.position)
            })).sort((a, b) => b.goals - a.goals);
            
            container.innerHTML = `
                <div class="trophy-display">
                    <div class="trophy">${isChampion ? '🏆' : '😢'}</div>
                    <h1 class="result-title ${isChampion ? 'winner' : 'loser'}">
                        ${isChampion ? 'WORLD CHAMPIONS!' : 'ELIMINATED'}
                    </h1>
                    <p class="result-subtitle">
                        ${isChampion ? 
                            `Your Dream Team conquered ${gameState.tournament.name}!` : 
                            `Knocked out in the ${roundReached === 'GROUP' ? 'Group Stage' : roundReached}`
                        }
                    </p>
                </div>
                
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="label">Team Rating</div>
                        <div class="value">${calculateTeamRating()}</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Matches</div>
                        <div class="value">${gameState.matches.length}</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Record</div>
                        <div class="value">${wins}W ${draws}D ${losses}L</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Goals</div>
                        <div class="value">${totalGoals} - ${totalConceded}</div>
                    </div>
                </div>
                
                <h3 style="margin: 30px 0 20px; color: var(--text-secondary);">Player Statistics</h3>
                
                <table class="player-stats-table">
                    <thead>
                        <tr>
                            <th>Player</th>
                            <th>Nation</th>
                            <th>Pos</th>
                            <th>Rating</th>
                            <th>Goals</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${playerStats.map(p => `
                            <tr>
                                <td>${p.name}</td>
                                <td>${p.countryFlag}</td>
                                <td>${p.position.replace(/_\d+$/, '')}</td>
                                <td class="rating-cell">${p.effectiveRating}</td>
                                <td>${p.goals}</td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
                
                <div class="match-history">
                    <h3>Match History</h3>
                    ${gameState.matches.map(m => {
                        const userScore = m.team1.isUser ? m.score1 : m.score2;
                        const oppScore = m.team1.isUser ? m.score2 : m.score1;
                        const opponent = m.team1.isUser ? m.team2 : m.team1;
                        const won = userScore > oppScore;
                        const draw = userScore === oppScore;
                        
                        return `
                            <div class="history-item">
                                <span class="round">${m.stage}</span>
                                <span>${opponent.flag} ${opponent.name}</span>
                                <span class="result ${won ? 'win' : draw ? '' : 'loss'}">
                                    ${userScore} - ${oppScore}
                                </span>
                            </div>
                        `;
                    }).join('')}
                </div>
            `;
            
            document.getElementById('playAgainBtn').onclick = () => {
                // Reset game state
                gameState = {
                    difficulty: 'easy',
                    ratingMode: 'tournament',
                    tournament: null,
                    formation: '4-3-3',
                    rerollsLeft: 3,
                    currentPositionIndex: 0,
                    team: [],
                    rolledCountry: null,
                    selectedPlayer: null,
                    matches: [],
                    eliminated: false,
                    groupStage: null,
                    knockoutRound: null
                };
                
                // Reset UI
                document.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('selected'));
                document.querySelector('.diff-btn.easy').classList.add('selected');
                document.querySelectorAll('.rating-btn').forEach(b => b.classList.remove('selected'));
                document.querySelector('.rating-btn[data-rating="tournament"]').classList.add('selected');
                document.getElementById('confirmTournamentBtn').disabled = true;
                
                showScreen('start');
            };
        }

        // ============ INIT ============
        initStartScreen();
    </script>
</body>
</html>
