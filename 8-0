        function confirmPlayer() {
            const container = document.getElementById('playerSelection');
            const players = JSON.parse(container.dataset.players);
            const positionId = container.dataset.positionId;
            
            const selectedPlayer = players[gameState.selectedPlayer];
            
            gameState.team.push({
                position: positionId,
                player: selectedPlayer
            });
            
            gameState.currentPositionIndex++;
            gameState.selectedPlayer = null;
            gameState.rolledCountry = null;
            
            // Reset UI
            container.style.display = 'none';
            document.getElementById('confirmPlayerBtn').disabled = true;
            document.getElementById('rollCountryBtn').style.display = 'inline-block';
            document.getElementById('rerollBtn').style.display = 'none';
            document.getElementById('countryFlag').textContent = '🌍';
            document.getElementById('countryName').textContent = 'Press Roll';
            
            renderPitch();
            updateBuilderUI();
            
            // Check if team is complete
            if (gameState.currentPositionIndex >= 11) {
                startTournament();
            }
        }

        // ============ SIMULATION ============
        function startTournament() {
            showScreen('sim');
            gameState.matches = [];
            gameState.eliminated = false;
            
            // Create tournament structure
            setupGroupStage();
        }

        function setupGroupStage() {
            const countries = [...COUNTRIES[gameState.tournament.id]];
            
            // Create groups
            const groups = { A: [], B: [], C: [], D: [], E: [], F: [], G: [], H: [] };
            const groupNames = Object.keys(groups);
            
            // Shuffle countries
            for (let i = countries.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [countries[i], countries[j]] = [countries[j], countries[i]];
            }
            
            // Assign to groups
            countries.forEach((country, i) => {
                const groupIndex = i % 8;
                groups[groupNames[groupIndex]].push({
                    ...country,
                    points: 0,
                    gd: 0,
                    gf: 0,
                    ga: 0,
                    played: 0
                });
            });
            
            // Create user team entry
            const userTeam = {
                name: 'Dream Team',
                flag: '⭐',
                rating: calculateTeamRating(),
                points: 0,
                gd: 0,
                gf: 0,
                ga: 0,
                played: 0,
                isUser: true
            };
            
            // Add user to a random group, replacing weakest team
            const userGroup = getRandomElement(groupNames);
            groups[userGroup].sort((a, b) => a.rating - b.rating);
            groups[userGroup][0] = userTeam;
            
            gameState.groupStage = {
                groups,
                userGroup,
                currentMatchIndex: 0,
                phase: 'group'
            };
            
            simulateGroupStage();
        }

        function simulateGroupStage() {
            const { groups, userGroup } = gameState.groupStage;
            const userTeamGroup = groups[userGroup];
            const userTeam = userTeamGroup.find(t => t.isUser);
            const opponents = userTeamGroup.filter(t => !t.isUser);
            
            // User plays 3 group games
            showGroupMatchSequence(userTeam, opponents, 0);
        }

        function showGroupMatchSequence(userTeam, opponents, matchIndex) {
            if (matchIndex >= 3) {
                // All group games done, show standings then proceed
                showGroupStandings();
                return;
            }
            
            const opponent = opponents[matchIndex];
            const result = simulateMatch(userTeam, opponent, 'group');
            
            // Update standings
            if (result.userWin) {
                userTeam.points += 3;
            } else if (result.draw) {
                userTeam.points += 1;
                opponent.points += 1;
            } else {
                opponent.points += 3;
            }
            
            userTeam.gf += result.userGoals;
            userTeam.ga += result.opponentGoals;
            userTeam.gd += (result.userGoals - result.opponentGoals);
            userTeam.played++;
            
            opponent.gf += result.opponentGoals;
            opponent.ga += result.userGoals;
            opponent.gd += (result.opponentGoals - result.userGoals);
            opponent.played++;
            
            gameState.matches.push(result);
            
            displayMatch(result, 'GROUP STAGE - MATCH ' + (matchIndex + 1), () => {
                showGroupMatchSequence(userTeam, opponents, matchIndex + 1);
            });
        }

        function simulateMatch(team1, team2, stage) {
            const rating1 = team1.rating;
            const rating2 = team2.rating;
            
            const ratingDiff = (rating1 - rating2) / 100;
            const baseProb = 0.5 + (ratingDiff * 0.4);
            
            // Simulate goals
            let goals1 = 0, goals2 = 0;
            const maxGoals = stage === 'group' ? 5 : 4;
            
            for (let i = 0; i < 10; i++) {
                if (Math.random() < (baseProb * 0.25)) goals1++;
                if (Math.random() < ((1 - baseProb) * 0.25)) goals2++;
            }
            
            goals1 = Math.min(goals1, maxGoals);
            goals2 = Math.min(goals2, maxGoals);
            
            // In knockout, handle draws
            let penalties = false;
            let extraTime = false;
            
            if (stage !== 'group' && goals1 === goals2) {
                extraTime = true;
                // Extra time
                if (Math.random() < baseProb * 0.3) goals1++;
                else if (Math.random() < (1 - baseProb) * 0.3) goals2++;
                
                // Still draw? Penalties
                if (goals1 === goals2) {
                    penalties = true;
                    if (Math.random() < 0.5 + (ratingDiff * 0.1)) {
                        goals1++;
                    } else {
                        goals2++;
                    }
                }
            }
            
            // Generate events
            const events = [];
            const scorers1 = [];
            const scorers2 = [];
            
            for (let i = 0; i < goals1; i++) {
                const minute = Math.floor(Math.random() * 90) + 1;
                const scorer = team1.isUser ? 
                    getRandomElement(gameState.team).player : 
                    { name: `${team1.name} Player` };
                events.push({ minute, type: 'goal', team: 'home', player: scorer.name });
                scorers1.push(scorer.name);
                
                if (team1.isUser) {
                    const teamPlayer = gameState.team.find(t => t.player.name === scorer.name);
                    if (teamPlayer) teamPlayer.player.goals++;
                }
            }
            
            for (let i = 0; i < goals2; i++) {
                const minute = Math.floor(Math.random() * 90) + 1;
                const scorer = team2.isUser ? 
                    getRandomElement(gameState.team).player : 
                    { name: `${team2.name} Player` };
                events.push({ minute, type: 'goal', team: 'away', player: scorer.name });
                scorers2.push(scorer.name);
                
                if (team2.isUser) {
                    const teamPlayer = gameState.team.find(t => t.player.name === scorer.name);
                    if (teamPlayer) teamPlayer.player.goals++;
                }
            }
            
            // Add some random cards
            if (Math.random() > 0.7) {
                events.push({
                    minute: Math.floor(Math.random() * 90) + 1,
                    type: 'yellow',
                    team: Math.random() > 0.5 ? 'home' : 'away',
                    player: 'A Player'
                });
            }
            
            events.sort((a, b) => a.minute - b.minute);
            
            // Generate commentary
            const commentary = generateCommentary(team1, team2, goals1, goals2, penalties, extraTime);
            
            return {
                team1,
                team2,
                score1: goals1,
                score2: goals2,
                userGoals: team1.isUser ? goals1 : goals2,
                opponentGoals: team1.isUser ? goals2 : goals1,
                userWin: team1.isUser ? goals1 > goals2 : goals2 > goals1,
                draw: goals1 === goals2 && stage === 'group',
                events,
                commentary,
                penalties,
                extraTime,
                stage
            };
        }

        function generateCommentary(team1, team2, goals1, goals2, penalties, extraTime) {
            const userTeam = team1.isUser ? team1 : team2;
            const opponent = team1.isUser ? team2 : team1;
            const userGoals = team1.isUser ? goals1 : goals2;
            const oppGoals = team1.isUser ? goals2 : goals1;
            
            let type = 'scrappy';
            
            if (userGoals > oppGoals) {
                if (userGoals - oppGoals >= 3) type = 'dominant';
                else if (userTeam.rating < opponent.rating - 5) type = 'upset';
                else type = 'scrappy';
            } else if (userGoals < oppGoals) {
                if (goals1 + goals2 >= 4 && Math.random() > 0.5) type = 'bottlejob';
                else type = 'heartbreak';
            } else {
                type = 'scrappy';
            }
            
            if (penalties) type = 'penalty_drama';
            
            let comment = getRandomElement(COMMENTARY[type]);
            comment = comment.replace('{team}', userTeam.name);
            
            return comment;
        }

        function displayMatch(result, header, onContinue) {
            const container = document.getElementById('simContent');
            const btn = document.getElementById('nextMatchBtn');
            
            container.innerHTML = `
                <div class="match-card">
                    <div class="match-header">${header}</div>
